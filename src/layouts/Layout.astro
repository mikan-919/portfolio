---
import { ClientRouter } from 'astro:transitions'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import '@/styles/global.css'
import Fonts from './Fonts.astro'

type StructuredData = Record<string, unknown>

type Props = {
  title?: string
  description?: string
  ogImage?: string
  ogType?: 'website' | 'article'
  structuredData?: StructuredData | StructuredData[]
}

const {
  title,
  description = 'Web・言語処理系・開発者ツールを作る学生エンジニア、摘果みかんのポートフォリオ。',
  ogImage = '/og/site/home.png',
  ogType = 'website',
  structuredData,
}: Props = Astro.props

const pageTitle = title ? `${title} | mikan-919` : 'mikan-919'
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : null

// 1画面構成: Header とステータスバー(Footer)の間のステージ(main)だけが入れ替わる。
// ページはステージに収め、はみ出す中身は [data-pager] で横に送る(src/lib/pager.ts)。
// 収まらないほど低い画面でだけ main が縦にスクロールする。遷移の演出は global.css。
---

<!doctype html>
<html lang="ja">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1c1c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="k4cB2IegdjFuoL4Elw6MHo6Mn6OvftHdZg5O03GwMDo" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" type="application/rss+xml" title="mikan-919 Blog RSS" href="/blog/rss.xml" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <Fonts />
    <script is:inline>
      // HTML-in-Canvas 対応かつモーション許可のときだけ fx を有効にする(src/lib/fx.ts)。
      ;(() => {
        const canvas = document.createElement('canvas')
        canvas.setAttribute('content', 'drawable')
        const apply = () =>
          document.documentElement.classList.toggle(
            'fx-on',
            canvas.content === 'drawable' && !matchMedia('(prefers-reduced-motion: reduce)').matches,
          )
        apply()
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>
    {
      /* Cloudflare Web Analytics。本番だけで読み込む。ページ遷移後の閲覧は、計測スクリプトが history の変化を見て数える */
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "3d2dee7037a34e269e8baa75cea9d7cf"}'
        ></script>
      )
    }
  </head>
  <body class="font-sans bg-lp-bg h-dvh overflow-hidden grid grid-rows-[auto_minmax(0,1fr)_auto]" id="root">
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <Header />
    <main id="main-content" class="relative min-h-0 overflow-y-auto bg-lp-bg" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/lib/flow'
      import '@/lib/scene'
    </script>
  </body>
</html>
