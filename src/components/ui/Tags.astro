---
type Props = {
    tags: string[];
    link:(tag:string)=>string;
};
const {tags,link}:Props=Astro.props
---
<div class="flex flex-wrap gap-2">
    {
        tags.map((tag) => (
            <a
                href={link(tag)}
                class="chip px-3 py-1.5 hover:bg-lp-border-subtle transition-colors"
            >
                #{tag}
            </a>
        ))
    }
</div>
