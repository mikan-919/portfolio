---
// 本文の最後に置く前後のリンク。
type NavItem = {
  href: string
  title: string
}
type Props = {
  prev: NavItem | null
  next: NavItem | null
  prevLabel: string
  nextLabel: string
  backHref: string
  backLabel: string
}
const { prev, next, prevLabel, nextLabel, backHref, backLabel }: Props = Astro.props

const links = [prev && { ...prev, label: prevLabel }, next && { ...next, label: nextLabel }].filter((link) => link !== null)
---

<nav aria-label="前後のページ" class="mt-8">
  {
    links.map(({ href, title, label }) => (
      <a href={href} class="group flex min-h-11 flex-col justify-center gap-1 border-b border-lp-border-subtle py-3">
        <span class="label-tech">{label}</span>
        <span class="text-sm font-medium leading-snug text-lp-text line-clamp-2 transition-colors group-hover:text-lp-highlight">{title}</span>
      </a>
    ))
  }
  <a href={backHref} class="mt-4 inline-flex min-h-11 items-center text-sm text-lp-highlight hover:underline underline-offset-4">
    {backLabel}
  </a>
</nav>
