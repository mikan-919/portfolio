---















import SlideButton from '@/components/ui/SlideButton.astro';

type Props = {
    categories: string[];
};

const { categories } = Astro.props;
---

<div class="filter-container">
    <div class="flex justify-between items-end">
        <div>
            <div class="pb-5">
                <h2 class="text-5xl tracking-tighter font-black leading-none">
                    ALL PROJECTS
                </h2>
            </div>
            <div class="flex flex-wrap gap-2 pt-2" id="filter-container">
                {
                    categories.map((cat) => (
                        <SlideButton
                            asButton
                            direction="bottom"
                            data-filter={cat}
                            class={`filter-btn relative group ${cat === "All" ? "bg-black text-white" : "bg-white text-black"}`}
                        >
                            <span>{cat}</span>
                        </SlideButton>
                    ))
                }
            </div>
        </div>
    </div>
</div>
