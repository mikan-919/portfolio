---
type Props = {
    categories: string[];
};

const { categories } = Astro.props;
---

<div class="filter-container">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-display text-4xl leading-none tracking-tight text-lp-text mb-5">
                ALL PROJECTS
            </h2>
            <div class="flex flex-wrap gap-2" id="filter-container">
                {
                    categories.map((cat) => (
                        <button
                            data-filter={cat}
                            class={`filter-btn ${cat === 'All' ? 'bg-lp-accent text-lp-accent-on border-transparent' : ''}`}
                        >
                            {cat}
                        </button>
                    ))
                }
            </div>
        </div>
    </div>
</div>
