---
import { sortByDateAscending } from "@/lib/collectionUtils";
import type { WorksListProps } from "@/types/collections";

type Props = WorksListProps;

const { works } = Astro.props;

const totalWorks = works.length

const sortedWorks = sortByDateAscending(works)

let worksPerYear = 0;
if (sortedWorks.length > 0) {
    const firstDate = sortedWorks[0].data.date;
    const lastDate = new Date();

    const yearsDiff =
        lastDate.getFullYear() -
        firstDate.getFullYear() +
        (lastDate.getMonth() - firstDate.getMonth()) / 12;

    worksPerYear = yearsDiff > 0 ? totalWorks / yearsDiff : totalWorks;
}
---

<div class="section-header">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
            <p class="font-mono text-xs text-lp-muted uppercase tracking-[0.06em] mb-2">
                PROJECT ARCHIVE
            </p>
            <h1 class="font-display text-6xl md:text-8xl leading-none tracking-tight text-lp-text">
                WORKS.
            </h1>
        </div>

        <div class="hidden md:flex gap-12 text-right">
            <div>
                <p class="font-display text-[40px] leading-none text-lp-text">{totalWorks}</p>
                <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em] mt-1">TOTAL PROJECTS</p>
            </div>
            <div class="w-px bg-lp-border-subtle"></div>
            <div>
                <p class="font-display text-[40px] leading-none text-lp-text">{worksPerYear.toFixed(1)}</p>
                <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em] mt-1">PROJECTS / YEAR</p>
            </div>
        </div>
    </div>
</div>
