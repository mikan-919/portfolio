---
import type { WorksListProps } from "@/types/collections";
import WorkCard from "../WorkCard.astro";

type Props = WorksListProps;

const { works } = Astro.props;
---

<div class="px-8 md:px-16 lg:px-[7.5rem] py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
            works.map((work) => (
                <div
                    class="work-item h-full"
                    data-category={work.data.category}
                >
                    <WorkCard {...work.data} id={work.id} />
                </div>
            ))
        }
    </div>
    <div id="no-results" class="hidden py-16 text-center font-mono text-sm text-lp-muted">
        No projects found in this category.
    </div>
</div>
