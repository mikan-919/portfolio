---
import Github from "simple-icons-astro/Github";
---

<div class="w-full border-t border-lp-border">
    <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-16 flex flex-col items-center text-center">
        <p class="text-xs text-lp-subtle mb-3">More work</p>
        <h3 class="font-display text-3xl leading-tight tracking-tight text-lp-text mb-4">More Projects?</h3>
        <p class="text-sm text-lp-muted leading-relaxed mb-8 max-w-md">
            ここには掲載していない小さな実験や、学習の過程のコードはGitHubで公開しています。
        </p>
        <a
            href="https://github.com/mikan-919"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center min-h-11 gap-2.5 rounded-full bg-lp-accent text-lp-accent-on text-sm px-5 hover:bg-lp-accent-strong transition-colors"
        >
            <Github class="size-4" />
            Visit GitHub Profile
        </a>
    </div>
</div>
