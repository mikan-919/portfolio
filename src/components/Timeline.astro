---
import { getCollection } from 'astro:content'

// 経歴を古い順に並べる。PC では横一列、モバイルでは縦に積み、日付と題を1行に、説明を1行に詰める(dark 面に置く前提の配色)。
const raw = await getCollection('timeline')
const items = raw.map((e) => e.data).sort((a, b) => a.date.localeCompare(b.date))

function formatDate(rawDate: string): string {
  const [year, month] = rawDate.split('-')
  if (!month || month.includes('X')) return year
  return `${year} · ${month}`
}
---

<ol
  class="relative grid gap-3 before:absolute before:inset-y-1 before:left-[4px] before:w-px before:bg-lp-dark-muted/40 lg:grid-cols-[repeat(var(--count),minmax(0,1fr))] lg:gap-0 lg:before:inset-x-0 lg:before:top-[5px] lg:before:bottom-auto lg:before:h-px lg:before:w-auto"
  style={`--count: ${items.length}`}
>
  {
    
    items.map((item, index) => (
      <li class="relative pl-7 lg:pl-0 lg:pr-5 lg:pt-8">
        <span
          class={`absolute left-0 top-1.5 size-2.5 rotate-45 lg:top-0 ${index === items.length - 1 ? 'bg-lp-highlight' : 'bg-lp-dark-text'}`}
          aria-hidden="true"
        />
        <div class="flex items-baseline gap-3 lg:block">
          <span class="block shrink-0 font-mono text-[11px] text-lp-dark-muted">{formatDate(item.date)}</span>
          <h3 class="font-display text-base leading-tight text-lp-dark-text lg:mt-1 lg:text-lg">{item.title}</h3>
        </div>
        <p class="mt-1 text-xs leading-relaxed text-lp-dark-muted line-clamp-1 lg:line-clamp-none">{item.desc}</p>
      </li>
    ))
  }
</ol>
