---
type Props = {
  eyebrow: string
  title: string
  total: number
  totalLabel: string
  rate: number
  rateLabel: string
}
const { eyebrow, title, total, totalLabel, rate, rateLabel }: Props = Astro.props
---

<div class="section-header">
  <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-4">
    <div>
      <p class="font-mono text-xs text-lp-muted uppercase tracking-[0.06em] mb-2">{eyebrow}</p>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-8xl leading-none tracking-tight text-lp-text" style="overflow-wrap: anywhere;">
        {title}
      </h1>
    </div>

    <div class="hidden lg:flex gap-12 text-right">
      <div>
        <p class="font-display text-[40px] leading-none text-lp-text">{total}</p>
        <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em] mt-1">{totalLabel}</p>
      </div>
      <div class="w-px bg-lp-border-subtle"></div>
      <div>
        <p class="font-display text-[40px] leading-none text-lp-text">{rate.toFixed(1)}</p>
        <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em] mt-1">{rateLabel}</p>
      </div>
    </div>
  </div>
</div>
