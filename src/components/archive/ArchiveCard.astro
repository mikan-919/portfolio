---
import CoverImage from '@/components/ui/CoverImage.astro'
import type { ArchiveCardData } from '@/types/cards'

type Props = {
  data: ArchiveCardData
}
const { data }: Props = Astro.props
---

<a
  href={data.href}
  class={`group card-cut flex flex-col overflow-hidden h-full ${data.comingSoon ? 'pointer-events-none' : ''}`}
>
  <div class="aspect-video relative overflow-hidden bg-lp-surface-sunken">
    <CoverImage src={data.image} alt={data.title} class="image-hover-effect w-full h-full object-cover" />
    {
      data.comingSoon && (
        <div class="absolute inset-0 flex items-center justify-center bg-lp-bg/80">
          <span class="text-xs text-lp-muted">Coming Soon</span>
        </div>
      )
    }
  </div>

  <div class="p-6 flex flex-col gap-2 flex-1">
    {data.meta && <span class="label-tech">{data.meta}</span>}
    <h3 class="font-display text-xl leading-tight text-lp-text">
      {data.title}
    </h3>
    <p class="text-sm text-lp-muted leading-relaxed line-clamp-2 flex-1">
      {data.excerpt}
    </p>
    <div class="flex flex-wrap gap-1.5 mt-2">
      {
        data.tags.slice(0, 3).map((tag) => (
          <span class="chip group-hover:bg-lp-surface">#{tag}</span>
        ))
      }
    </div>
  </div>
</a>
