---
import CoverImage from '@/components/ui/CoverImage.astro'
import { formatShortDateJP } from '@/lib/dateUtils'
import type { ArchiveCardData } from '@/types/cards'

type Props = {
  data: ArchiveCardData
}
const { data }: Props = Astro.props
---

<!-- 列の高さいっぱいの縦長カード。画像が余りの高さを埋める -->
<a
  href={data.href}
  data-flip
  class={`group card-cut flex h-full flex-col overflow-hidden ${data.comingSoon ? 'pointer-events-none' : ''}`}
>
  <div data-flip-part="cover" class="relative min-h-24 flex-1 overflow-hidden bg-lp-surface-sunken">
    <CoverImage src={data.image} alt="" class="image-hover-effect absolute inset-0 size-full object-cover" />
    {
      data.comingSoon && (
        <div class="absolute inset-0 flex items-center justify-center bg-lp-bg/80">
          <span class="text-xs text-lp-muted">Coming Soon</span>
        </div>
      )
    }
  </div>

  <div class="flex flex-col gap-2 p-5">
    <div class="flex items-center gap-3">
      {data.meta && <span class="label-tech">{data.meta}</span>}
      <span class="ml-auto font-mono text-xs text-lp-muted">{formatShortDateJP(data.date)}</span>
    </div>
    <h2 data-flip-part="title" class="font-display text-xl leading-tight text-lp-text line-clamp-2">
      {data.title}
    </h2>
    <p class="text-sm text-lp-muted leading-relaxed line-clamp-2">
      {data.excerpt}
    </p>
    <div class="mt-1 flex flex-wrap gap-1.5">
      {
        data.tags.slice(0, 3).map((tag) => (
          <span class="chip group-hover:bg-lp-surface">#{tag}</span>
        ))
      }
    </div>
  </div>
</a>
