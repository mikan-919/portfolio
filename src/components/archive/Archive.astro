---
import type { CollectionEntry } from 'astro:content'
import ArchiveCard from '@/components/archive/ArchiveCard.astro'
import ArchiveFilter from '@/components/archive/ArchiveFilter.astro'
import ArchiveHeader from '@/components/archive/ArchiveHeader.astro'
import PagerBar from '@/components/ui/PagerBar.astro'
import { type ArchiveCardData, articleToCard, workToCard } from '@/types/cards'

type Props = ({ kind: 'work'; entries: CollectionEntry<'works'>[] } | { kind: 'article'; entries: CollectionEntry<'articles'>[] }) & {
  // タグ別一覧: タグを見出しにし、絞り込みの代わりに一覧へ戻るリンクを出す。
  tag?: string
}

const props = Astro.props as Props
const { kind, tag } = props
const isWork = kind === 'work'

const items: ArchiveCardData[] = props.kind === 'work' ? props.entries.map(workToCard) : props.entries.map(articleToCard)
// 絞り込みの候補は件数の多い順。
const counts = new Map<string, number>()
for (const key of items.flatMap((item) => item.filterKeys)) counts.set(key, (counts.get(key) ?? 0) + 1)
const options = ['All', ...[...counts.keys()].sort((a, b) => (counts.get(b) ?? 0) - (counts.get(a) ?? 0))]

// 最初のエントリからの経過で、Works は年あたり、Blog は月あたりの件数を出す。
const total = items.length
const now = new Date()
const first = items.reduce<Date | undefined>((min, item) => (!min || item.date < min ? item.date : min), undefined)
const months = first ? (now.getFullYear() - first.getFullYear()) * 12 + (now.getMonth() - first.getMonth()) : 0
const span = isWork ? months / 12 : months + 1
const rate = span > 0 ? total / span : total

const copy = isWork
  ? { eyebrow: 'Project archive', title: 'Works', ja: '制作実績', totalLabel: 'Projects', rateLabel: 'Per year', back: '/works' }
  : { eyebrow: 'Blog archive', title: 'Blog', ja: '記事', totalLabel: 'Articles', rateLabel: 'Per month', back: '/blog' }
const emptyLabel = isWork ? 'No projects found in this category.' : 'No articles found with this tag.'
---

<!-- 左(モバイルでは上)に見出しと絞り込み、右にカードの列。列は横にページ送りする -->
<div class="grid h-full grid-rows-[auto_minmax(0,1fr)] lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:grid-rows-1">
  <aside class="flex min-w-0 flex-col gap-3 px-5 pt-5 sm:px-8 md:px-16 lg:gap-8 lg:overflow-y-auto lg:border-r lg:[scrollbar-width:none] lg:border-lp-border-subtle lg:py-10 lg:pr-10 xl:pl-[7.5rem]">
    <ArchiveHeader
      eyebrow={tag ? `${copy.title} tag` : copy.eyebrow}
      title={tag ? `#${tag}` : copy.title}
      ja={tag ? undefined : copy.ja}
      plain={Boolean(tag)}
      total={total}
      totalLabel={copy.totalLabel}
      rate={rate}
      rateLabel={copy.rateLabel}
    />
    {
      tag ? (
        <a href={copy.back} class="inline-flex min-h-11 items-center text-sm text-lp-highlight hover:underline underline-offset-4">
          ← {copy.title} の一覧へ
        </a>
      ) : (
        <ArchiveFilter options={options} labelPrefix={isWork ? '' : '#'} />
      )
    }
    {
      isWork && !tag && (
        <a
          href="https://github.com/mikan-919"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-auto hidden text-sm leading-relaxed text-lp-muted hover:text-lp-text lg:block"
        >
          掲載していない小さな実験や学習のコードは GitHub にあります ↗
        </a>
      )
    }
  </aside>

  <section class="flex min-h-0 min-w-0 flex-col gap-4 px-5 pb-4 pt-3 sm:px-8 md:px-16 lg:py-10 lg:pl-10 xl:pr-[7.5rem]" aria-label="一覧">
    <div
      data-pager
      class="grid min-h-0 flex-1 grid-flow-col gap-4 auto-cols-[calc((100%-(var(--n)-1)*1rem)/var(--n))] [--n:1] md:[--n:2] xl:[--n:3]"
    >
      {
        items.map((item) => (
          <div class="archive-item min-w-0" data-filter-keys={JSON.stringify(item.filterKeys)}>
            <ArchiveCard data={item} />
          </div>
        ))
      }
    </div>
    <p id="no-results" hidden class="py-16 text-center font-mono text-sm text-lp-muted">{emptyLabel}</p>
    <PagerBar />
  </section>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn')
    const items = document.querySelectorAll<HTMLElement>('.archive-item')
    const noResults = document.getElementById('no-results')

    const applyFilter = (filter: string) => {
      for (const button of buttons) {
        const isActive = button.dataset.filter === filter
        button.classList.toggle('is-active', isActive)
        button.setAttribute('aria-pressed', String(isActive))
      }
      let visibleCount = 0
      for (const item of items) {
        const keys = JSON.parse(item.dataset.filterKeys || '[]') as string[]
        item.hidden = !(filter === 'All' || keys.includes(filter))
        if (!item.hidden) visibleCount++
      }
      if (noResults) noResults.hidden = visibleCount > 0
      document.querySelector('[data-pager]')?.dispatchEvent(new Event('pager:refresh'))
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter
        if (!filter) return
        applyFilter(filter)
        const url = new URL(window.location.href)
        if (filter === 'All') url.searchParams.delete('filter')
        else url.searchParams.set('filter', filter)
        window.history.pushState({}, '', url)
      })
    }

    const initialFilter = new URLSearchParams(window.location.search).get('filter')
    if (initialFilter && [...buttons].some((b) => b.dataset.filter === initialFilter)) applyFilter(initialFilter)
  })
</script>
