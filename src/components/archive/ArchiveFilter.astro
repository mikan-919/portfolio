---
type Props = {
  heading: string
  options: string[]
  labelPrefix?: string
}
const { heading, options, labelPrefix = '' }: Props = Astro.props
---

<div class="filter-container">
  <div class="flex justify-between items-end">
    <div>
      <h2 class="flex items-center gap-4 font-display text-2xl md:text-3xl uppercase leading-none tracking-[0.04em] text-lp-text mb-5">
        <span class="size-2 shrink-0 bg-lp-highlight" aria-hidden="true"></span>
        {heading}
      </h2>
      <div class="flex flex-wrap gap-x-5 gap-y-2" id="filter-container">
        {
          options.map((opt) => (
            <button
              type="button"
              data-filter={opt}
              aria-pressed={opt === 'All' ? 'true' : 'false'}
              class={`filter-btn ${opt === 'All' ? 'is-active' : ''}`}
            >
              {opt === 'All' ? opt : `${labelPrefix}${opt}`}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>
