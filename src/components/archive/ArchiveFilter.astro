---
type Props = {
  options: string[]
  labelPrefix?: string
}
const { options, labelPrefix = '' }: Props = Astro.props
---

<!-- PC では詰めて折り返し、モバイルでは1行に収めて横にスクロールする -->
<div class="min-w-0">
  <p class="label-tech max-lg:hidden">Filter</p>
  <div class="flex gap-x-5 gap-y-1 max-lg:overflow-x-auto max-lg:whitespace-nowrap max-lg:[scrollbar-width:none] lg:mt-2 lg:flex-wrap">
    {
      options.map((opt) => (
        <button
          type="button"
          data-filter={opt}
          aria-pressed={opt === 'All' ? 'true' : 'false'}
          class={`filter-btn shrink-0 lg:min-h-0 lg:text-xs lg:leading-tight ${opt === 'All' ? 'is-active' : ''}`}
        >
          {opt === 'All' ? opt : `${labelPrefix}${opt}`}
        </button>
      ))
    }
  </div>
</div>
