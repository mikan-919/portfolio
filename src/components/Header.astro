---
const pathname = Astro.url.pathname
const isCurrent = (href: string) => (href === '/' ? pathname === href : pathname.startsWith(href))
const navItems = [
  { href: '/works', label: 'Works', ja: '制作実績' },
  { href: '/blog', label: 'Blog', ja: '記事' },
  { href: '/about', label: 'About', ja: '人物' },
]

const wordmarkClass = 'font-display text-lg md:text-xl tracking-[0.04em] text-lp-text leading-none shrink-0'
// 英日2段。現在地は上端に柿色のバーを出す。
const navLinkClass =
  'group relative flex h-16 flex-col justify-center text-lp-muted hover:text-lp-text aria-[current=page]:text-lp-text transition-colors before:absolute before:inset-x-0 before:top-0 before:h-[3px] before:origin-left before:scale-x-0 before:bg-lp-highlight before:transition-transform hover:before:scale-x-100 aria-[current=page]:before:scale-x-100'
---

<header class="relative z-50 w-full bg-lp-bg border-b border-lp-border-subtle">
  <div class="px-5 sm:px-8 md:px-16 xl:px-[7.5rem] h-16 flex items-center gap-4 md:gap-10 relative">
    <a href="/" aria-current={isCurrent('/') ? 'page' : undefined} class={wordmarkClass}>
      MIKAN<span class="text-lp-highlight">-919</span>
    </a>

    <nav class="hidden sm:flex items-center gap-6 md:gap-10 ml-auto" aria-label="メインナビゲーション">
      {
        navItems.map(({ href, label, ja }) => (
          <a href={href} aria-current={isCurrent(href) ? 'page' : undefined} class={navLinkClass}>
            <span class="font-tech text-sm font-medium uppercase leading-none tracking-[0.14em]">{label}</span>
            <span class="mt-1 text-[10px] leading-none text-lp-subtle">{ja}</span>
          </a>
        ))
      }
    </nav>
    <a
      href="https://twitter.com/mikan_919_main"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:inline-flex items-center min-h-11 shrink-0 font-tech text-sm font-medium uppercase tracking-[0.14em] text-lp-text hover:text-lp-highlight transition-colors"
    >
      Contact ↗
    </a>

    <details class="group sm:hidden ml-auto">
      <summary class="list-none [&::-webkit-details-marker]:hidden inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center font-tech text-sm font-medium uppercase tracking-[0.14em] text-lp-text hover:bg-lp-surface-sunken transition-colors">
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <nav class="chamfer absolute top-full left-5 right-5 bg-lp-surface p-2 shadow-lg" aria-label="モバイルナビゲーション">
        {
          navItems.map(({ href, label, ja }) => (
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              class="flex min-h-12 items-baseline gap-3 px-4 py-3 text-lp-muted hover:bg-lp-surface-sunken hover:text-lp-text aria-[current=page]:bg-lp-surface-sunken aria-[current=page]:text-lp-highlight transition-colors"
            >
              <span class="font-tech text-sm font-medium uppercase tracking-[0.14em]">{label}</span>
              <span class="text-[11px] text-lp-subtle">{ja}</span>
            </a>
          ))
        }
        <a
          href="https://twitter.com/mikan_919_main"
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-12 items-center px-4 font-tech text-sm font-medium uppercase tracking-[0.14em] text-lp-muted hover:bg-lp-surface-sunken hover:text-lp-text transition-colors"
        >
          Contact ↗
        </a>
      </nav>
    </details>
  </div>
</header>
