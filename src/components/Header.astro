---
const pathname = Astro.url.pathname
const isCurrent = (href: string) => (href === '/' ? pathname === href : pathname.startsWith(href))
const navItems = [
  { href: '/works', label: 'Works' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
]

const wordmarkClass = 'font-display text-base md:text-lg tracking-tight text-lp-text leading-none shrink-0'
const navLinkClass =
  'inline-flex items-center min-h-11 text-sm text-lp-muted hover:text-lp-text aria-[current=page]:text-lp-text aria-[current=page]:underline aria-[current=page]:decoration-lp-highlight aria-[current=page]:decoration-2 underline-offset-4 transition-colors'
---

<header class="w-full bg-lp-bg/90 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] h-16 flex items-center gap-4 md:gap-8 relative">
    {
      isCurrent('/') ? (
        <a href="/" aria-current="page" class={wordmarkClass}>
          MIKAN<span class="text-lp-highlight">-919</span>
        </a>
      ) : (
        <a href="/" class={wordmarkClass}>
          MIKAN<span class="text-lp-highlight">-919</span>
        </a>
      )
    }

    <nav class="hidden sm:flex items-center gap-4 md:gap-7 ml-auto" aria-label="メインナビゲーション">
      {
        navItems.map(({ href, label }) =>
          isCurrent(href) ? (
            <a href={href} aria-current="page" class={navLinkClass}>
              {label}
            </a>
          ) : (
            <a href={href} class={navLinkClass}>
              {label}
            </a>
          ),
        )
      }
    </nav>
    <a
      href="https://twitter.com/mikan_919_main"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:inline-flex items-center min-h-11 shrink-0 text-sm text-lp-text hover:text-lp-highlight transition-colors"
    >
      Contact
    </a>

    <details class="group sm:hidden ml-auto">
      <summary class="list-none [&::-webkit-details-marker]:hidden inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full text-sm text-lp-text hover:bg-lp-surface-sunken transition-colors">
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <nav
        class="absolute top-[calc(100%-0.25rem)] left-5 right-5 rounded-lg bg-lp-surface p-2 shadow-lg"
        aria-label="モバイルナビゲーション"
      >
        {
          navItems.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              class="flex min-h-12 items-center rounded-md px-4 text-sm text-lp-muted hover:bg-lp-surface-sunken hover:text-lp-text aria-[current=page]:bg-lp-surface-sunken aria-[current=page]:text-lp-highlight transition-colors"
            >
              {label}
            </a>
          ))
        }
        <a
          href="https://twitter.com/mikan_919_main"
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-12 items-center rounded-md px-4 text-sm text-lp-muted hover:bg-lp-surface-sunken hover:text-lp-text transition-colors"
        >
          Contact ↗
        </a>
      </nav>
    </details>
  </div>
</header>
