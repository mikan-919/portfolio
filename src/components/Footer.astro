---
import { getCollection } from 'astro:content'
import { formatShortDateJP } from '@/lib/dateUtils'

const articles = await getCollection('articles')
const works = await getCollection('works')
const timestamps = [...articles, ...works].map((entry) => entry.data.date.getTime())
const lastUpdated = timestamps.length > 0 ? new Date(Math.max(...timestamps)) : new Date()

const navItems = [
  { href: '/works', label: 'Works' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/blog/rss.xml', label: 'RSS' },
  { href: 'https://github.com/mikan-919', label: 'GitHub', external: true },
  { href: 'https://twitter.com/mikan_919_main', label: 'X / Twitter', external: true },
  { href: 'https://zenn.dev', label: 'Zenn', external: true },
]
---

<footer class="w-full bg-lp-dark">
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-12 md:py-16">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xl">
        <p class="font-display text-4xl md:text-6xl leading-none tracking-tight text-lp-dark-text">
          MIKAN<span class="text-lp-dark-muted">-919</span>
        </p>
        <p class="mt-5 text-sm text-lp-dark-muted leading-relaxed">
          Web・言語処理系・開発者ツールを作る学生エンジニア。制作の依頼と連絡は X / Twitter へ。
        </p>
      </div>

      <nav class="grid grid-cols-2 gap-x-12 gap-y-1 text-sm" aria-label="フッターナビゲーション">
        {
          navItems.map(({ href, label, external }) => (
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class="inline-flex min-h-9 items-center text-lp-dark-muted hover:text-lp-dark-text transition-colors"
            >
              {label}
              {external && <span aria-hidden="true"> ↗</span>}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[11px] text-lp-dark-muted">&copy; {new Date().getFullYear()} mikan-919.</p>
      <p class="font-mono text-[11px] text-lp-dark-muted">Last updated {formatShortDateJP(lastUpdated)}</p>
      <p class="font-mono text-[11px] text-lp-dark-muted">
        Built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="hover:text-lp-dark-text transition-colors">Astro</a>.
      </p>
    </div>
  </div>
</footer>
