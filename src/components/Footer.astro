---
import { getCollection } from 'astro:content'
import { formatShortDateJP } from '@/lib/dateUtils'

const articles = await getCollection('articles')
const works = await getCollection('works')
const timestamps = [...articles, ...works].map((entry) => entry.data.date.getTime())
const lastUpdated = timestamps.length > 0 ? new Date(Math.max(...timestamps)) : new Date()

const links = [
  { href: '/blog/rss.xml', label: 'RSS' },
  { href: 'https://github.com/mikan-919', label: 'GitHub', external: true },
  { href: 'https://twitter.com/mikan_919_main', label: 'X', external: true },
  { href: 'https://zenn.dev/mikan_919', label: 'Zenn', external: true },
]
---

<!-- 画面下端のステータスバー -->
<footer class="w-full bg-lp-dark">
  <div class="flex h-10 items-center gap-4 px-5 sm:px-8 md:px-16 xl:px-[7.5rem]">
    <span class="hazard h-2 w-8 shrink-0" aria-hidden="true"></span>
    <p class="hidden sm:block font-mono text-[11px] text-lp-dark-muted">&copy; {new Date().getFullYear()} mikan-919</p>
    <p class="hidden md:block font-mono text-[11px] text-lp-dark-muted">Last updated {formatShortDateJP(lastUpdated)}</p>
    <nav class="ml-auto flex gap-4 sm:gap-6 font-tech text-[11px] font-medium uppercase tracking-[0.14em]" aria-label="外部リンク">
      {
        links.map(({ href, label, external }) => (
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="inline-flex min-h-10 items-center whitespace-nowrap text-lp-dark-muted hover:text-lp-dark-text transition-colors"
          >
            {label}
            {external && <span aria-hidden="true">&nbsp;↗</span>}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
