---
const skills = {
  Frontend: ['HTML / CSS', 'JavaScript', 'TypeScript', 'React', 'Astro'],
  Backend: ['Node.js', 'Hono', 'PostgreSQL'],
  Tools: ['Git', 'Figma', 'Cloudflare'],
}
---

<div class="w-full bg-lp-surface-sunken border-t border-lp-border-subtle">
  <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-[72px]">
    <!-- section header -->
    <div class="flex items-end gap-5 mb-10">
      <span class="font-zen-kaku-gothic-antique text-[88px] leading-[0.85] text-lp-border tracking-tight select-none">01</span>
      <div class="pb-1">
        <h2 class="font-zen-kaku-gothic-antique text-[36px] leading-none tracking-tight text-lp-text m-0">スキル</h2>
        <p class="font-mono text-[11px] text-lp-subtle uppercase tracking-widest mt-1 m-0">Skills &amp; Tech Stack</p>
      </div>
    </div>

    <!-- skills rows -->
    <div class="flex flex-col gap-4">
      {Object.entries(skills).map(([category, tags]) => (
        <div class="flex items-start gap-4">
          <span class="min-w-[80px] font-mono text-[11px] text-lp-muted uppercase tracking-wider pt-1">
            {category}
          </span>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="bg-lp-surface border border-lp-border-subtle rounded px-3 py-1 text-sm text-lp-text font-sans">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
