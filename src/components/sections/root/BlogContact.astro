---
import type { CollectionEntry } from 'astro:content'
import { formatShortDateJP } from '@/lib/dateUtils'
import type { ArticlesListProps } from '@/types/collections'

type Props = ArticlesListProps
const { articles }: Props = Astro.props

const shown = articles.slice(0, 3)
const featured = shown[0]
const rest = shown.slice(1)
---

<div class="w-full bg-lp-bg border-t border-lp-border-subtle">
  <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-[72px]">
    <!-- section header -->
    <div class="flex items-end justify-between mb-10">
      <div class="flex items-end gap-5">
        <span class="font-display text-[88px] leading-[0.85] text-lp-border tracking-tight select-none">03</span>
        <div class="pb-1">
          <h2 class="font-display text-[36px] leading-none tracking-tight text-lp-text m-0">最近の記事</h2>
          <p class="font-mono text-[11px] text-lp-subtle uppercase tracking-widest mt-1 m-0">Latest Posts</p>
        </div>
      </div>
      <a
        href="/blog"
        class="border border-lp-border text-lp-text font-sans text-sm px-4 py-2 rounded hover:bg-lp-surface transition-colors self-end mb-1"
      >
        すべて見る
      </a>
    </div>

    <!-- magazine grid -->
    {shown.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- featured -->
        {featured && (
          <a
            href={`/blog/${featured.id}`}
            class="md:col-span-2 bg-lp-surface border border-lp-border-subtle rounded p-8 flex flex-col gap-3 hover:border-lp-border transition-colors"
          >
            <span class="bg-lp-accent-subtle text-lp-accent-strong font-mono text-[11px] uppercase tracking-wider px-2.5 py-1 rounded-full w-fit">
              {featured.data.tags[0]}
            </span>
            <h3 class="font-display text-2xl leading-snug tracking-tight text-lp-text m-0">
              {featured.data.title}
            </h3>
            <p class="text-sm text-lp-muted leading-relaxed line-clamp-2">{featured.data.description}</p>
            <span class="font-mono text-xs text-lp-muted mt-auto">{formatShortDateJP(featured.data.date)}</span>
          </a>
        )}

        <!-- sidebar cards -->
        <div class="flex flex-col gap-4">
          {rest.map((article) => (
            <a
              href={`/blog/${article.id}`}
              class="bg-lp-surface border border-lp-border-subtle rounded p-5 flex flex-col gap-2 hover:border-lp-border transition-colors flex-1"
            >
              <span class="bg-lp-accent-subtle text-lp-accent-strong font-mono text-[11px] uppercase tracking-wider px-2 py-0.5 rounded-full w-fit">
                {article.data.tags[0]}
              </span>
              <h4 class="font-sans text-sm font-semibold text-lp-text leading-snug m-0">{article.data.title}</h4>
              <span class="font-mono text-[11px] text-lp-muted">{formatShortDateJP(article.data.date)}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>
