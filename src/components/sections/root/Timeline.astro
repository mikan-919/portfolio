---
import { getCollection } from 'astro:content'

const raw = await getCollection('timeline')
const items = raw
  .map((e) => e.data)
  .sort((a, b) => a.date.localeCompare(b.date))

function formatDate(raw: string): string {
  const [year, month] = raw.split('-')
  if (!month || month.includes('X')) return year
  return `${year} · ${month}`
}
---

<div class="w-full bg-lp-surface border-t border-lp-border-subtle">
  <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-[72px]">
    <!-- section header -->
    <div class="flex items-end gap-5 mb-14">
      <span class="font-display text-[88px] leading-[0.85] text-lp-border tracking-tight select-none">04</span>
      <div class="pb-1">
        <h2 class="font-display text-[36px] leading-none tracking-tight text-lp-text m-0">経歴</h2>
        <p class="font-mono text-[11px] text-lp-subtle uppercase tracking-widest mt-1 m-0">Timeline</p>
      </div>
    </div>

    <!-- horizontal timeline -->
    <div class="relative">
      <!-- horizontal line -->
      <div class="absolute left-[7px] right-0 top-[6px] h-[2px] bg-lp-border"></div>

      <div
        class="grid gap-0 relative"
        style={`grid-template-columns: repeat(${items.length}, 1fr)`}
      >
        {items.map((item) => (
          <div class="relative pt-7 pr-6">
            <!-- dot -->
            <div class="absolute top-0 left-0 w-[14px] h-[14px] rounded-full bg-lp-accent border-[3px] border-lp-surface"></div>
            <span class="font-mono text-[11px] text-lp-muted block mb-1">{formatDate(item.date)}</span>
            <h4 class="font-sans font-semibold text-sm text-lp-text m-0 mb-1">{item.title}</h4>
            <p class="font-sans text-xs text-lp-muted m-0 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
