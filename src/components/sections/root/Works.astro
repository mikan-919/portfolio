---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import type { WorksListProps } from '@/types/collections'

type Props = WorksListProps
const { works }: Props = Astro.props

const shown = works.slice(0, 3)
const featured = shown[0]
const rest = shown.slice(1)
---

<div class="w-full bg-lp-surface border-t border-lp-border-subtle">
  <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-[72px]">
    <!-- section header -->
    <div class="flex items-end gap-5 mb-10">
      <span class="font-zen-kaku-gothic-antique text-[88px] leading-[0.85] text-lp-border tracking-tight select-none">02</span>
      <div class="pb-1">
        <h2 class="font-zen-kaku-gothic-antique text-[36px] leading-none tracking-tight text-lp-text m-0">制作実績</h2>
        <p class="font-mono text-[11px] text-lp-subtle uppercase tracking-widest mt-1 m-0">Projects</p>
      </div>
    </div>

    <!-- bento grid -->
    {shown.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- featured -->
        {featured && (
          <a
            href={featured.data.isComingSoon ? undefined : `/works/${featured.id}`}
            class="md:row-span-2 bg-lp-accent-subtle border border-lp-border-subtle rounded p-8 md:p-10 flex flex-col gap-4 hover:border-lp-accent transition-colors"
          >
            <div class="flex-1 min-h-[160px] rounded overflow-hidden relative bg-lp-accent/10">
              {featured.data.image ? (
                <Image src={featured.data.image} alt={featured.data.title} class="w-full h-full object-cover" />
              ) : (
                <div class="absolute inset-0 opacity-20 bg-[radial-gradient(var(--color-lp-accent)_1px,transparent_1px)] bg-[length:16px_16px]" />
              )}
            </div>
            <h3 class="font-zen-kaku-gothic-antique text-[28px] leading-tight tracking-tight text-lp-text m-0">{featured.data.title}</h3>
            <p class="text-sm text-lp-muted leading-relaxed line-clamp-3">{featured.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {featured.data.tags.slice(0, 3).map((tag) => (
                <span class="bg-lp-surface border border-lp-border-subtle rounded px-2.5 py-0.5 text-xs text-lp-text font-sans">{tag}</span>
              ))}
            </div>
            <div class="flex justify-between items-center">
              <span class="font-mono text-xs text-lp-muted">{featured.data.date.getFullYear()}</span>
              <span class="text-sm font-sans text-lp-accent-strong font-semibold">見る →</span>
            </div>
          </a>
        )}

        <!-- smaller cards -->
        {rest.map((work) => (
          <a
            href={work.data.isComingSoon ? undefined : `/works/${work.id}`}
            class="bg-lp-surface-sunken border border-lp-border-subtle rounded p-7 flex flex-col gap-3 hover:border-lp-border transition-colors"
          >
            <h3 class="font-zen-kaku-gothic-antique text-xl leading-tight tracking-tight text-lp-text m-0">{work.data.title}</h3>
            <p class="text-sm text-lp-muted leading-relaxed line-clamp-2">{work.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {work.data.tags.slice(0, 3).map((tag) => (
                <span class="bg-lp-surface border border-lp-border-subtle rounded px-2.5 py-0.5 text-xs text-lp-text font-sans">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    )}

    <!-- view all -->
    <div class="mt-8 text-center">
      <a
        href="/works"
        class="inline-block border border-lp-border text-lp-text font-sans text-sm px-6 py-2.5 rounded hover:bg-lp-surface-sunken transition-colors"
      >
        すべての制作実績 →
      </a>
    </div>
  </div>
</div>
