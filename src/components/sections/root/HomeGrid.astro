---
import Timeline from '@/components/Timeline.astro'
import CoverImage from '@/components/ui/CoverImage.astro'
import SectionTitle from '@/components/ui/SectionTitle.astro'
import { pickFeatured } from '@/lib/collectionUtils'
import { coverUrl } from '@/lib/cover'
import { formatShortDateJP } from '@/lib/dateUtils'
import type { ArticlesListProps, WorksListProps } from '@/types/collections'

type Props = WorksListProps & ArticlesListProps

const { works, articles }: Props = Astro.props

const skills: Record<string, string[]> = {
  Frontend: ['HTML / CSS', 'JavaScript', 'TypeScript', 'React', 'Astro'],
  Systems: ['Rust', 'Compiler', 'WebAssembly'],
  Tools: ['Bun', 'Git', 'Docker', 'Cloudflare'],
}

const featuredArticle = pickFeatured(articles)
const featuredWork =
  pickFeatured(works.filter((work) => !featuredArticle?.data.title.includes(work.data.title))) ?? works[0]
const restWorks = works.filter((work) => work.id !== featuredWork?.id).slice(0, 3)
const restArticles = articles.filter((article) => article.id !== featuredArticle?.id).slice(0, 3)

const featured = 'card-cut group flex flex-col gap-4 p-5 md:p-7 lg:col-span-7'
// Works は左から、Blog は右から(Featured と行リストが逆方向から入る)。
const rows = 'lg:col-span-5 flex flex-col border-t border-lp-border-subtle'
// 行リスト。ホバーで左端に柿色のバーが立つ。
const row =
  'group relative flex flex-col gap-1.5 border-b border-lp-border-subtle py-5 pl-0 transition-[padding] duration-300 hover:pl-4 before:absolute before:inset-y-0 before:left-0 before:w-[3px] before:origin-top before:scale-y-0 before:bg-lp-highlight before:transition-transform before:duration-300 hover:before:scale-y-100'
---

<section class="w-full bg-lp-bg">
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-14 md:py-20 flex flex-col gap-20 md:gap-28">
    <!-- skills -->
    <div>
      <SectionTitle en="Skills" ja="技術" href="/about" linkLabel="プロフィールを見る" />
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
        {
          Object.entries(skills).map(([category, tags]) => (
            <div class="reveal border-l border-lp-border pl-4">
              <p class="label-tech mb-3">{category}</p>
              <div class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- works -->
    <div>
      <SectionTitle en="Works" ja="制作実績" href="/works" linkLabel="すべて見る" />
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
        {
          featuredWork && (
            <a href={featuredWork.data.isComingSoon ? undefined : `/works/${featuredWork.id}`} class={`${featured} reveal-l`} style="--cut: 28px">
              <div class="aspect-video relative overflow-hidden bg-lp-bg">
                <CoverImage
                  src={featuredWork.data.image ?? coverUrl('works', featuredWork.id)}
                  alt={featuredWork.data.title}
                  class="image-hover-effect w-full h-full object-cover"
                />
              </div>
              <div class="flex items-center justify-between">
                <span class="label-tech">Featured project</span>
                <span class="font-mono text-xs text-lp-muted">{featuredWork.data.date.getFullYear()}</span>
              </div>
              <h3 class="font-display text-2xl md:text-3xl leading-tight text-lp-text">{featuredWork.data.title}</h3>
              <p class="text-sm text-lp-muted leading-relaxed line-clamp-2">{featuredWork.data.description}</p>
            </a>
          )
        }
        <div class={rows}>
          {
            restWorks.map((work) => (
              <a href={work.data.isComingSoon ? undefined : `/works/${work.id}`} class={`${row} reveal-r`}>
                <div class="flex items-center justify-between">
                  <span class="label-tech">{work.data.category}</span>
                  <span class="font-mono text-xs text-lp-muted">{work.data.date.getFullYear()}</span>
                </div>
                <h4 class="font-display text-xl leading-tight text-lp-text group-hover:text-lp-highlight transition-colors">
                  {work.data.title}
                </h4>
                <p class="text-xs text-lp-muted leading-relaxed line-clamp-2">{work.data.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- blog -->
    <div>
      <SectionTitle en="Blog" ja="記事" href="/blog" linkLabel="すべて見る" />
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
        {
          featuredArticle && (
            <a href={`/blog/${featuredArticle.id}`} class={`${featured} reveal-r lg:order-2`} style="--cut: 28px">
              <div class="aspect-video relative overflow-hidden bg-lp-bg">
                <CoverImage
                  src={featuredArticle.data.image ?? coverUrl('articles', featuredArticle.id)}
                  alt={featuredArticle.data.title}
                  class="image-hover-effect w-full h-full object-cover"
                />
              </div>
              <div class="flex items-center justify-between">
                <span class="label-tech">Featured post</span>
                <span class="font-mono text-xs text-lp-muted">{formatShortDateJP(featuredArticle.data.date)}</span>
              </div>
              <h3 class="font-display text-2xl md:text-3xl leading-tight text-lp-text">{featuredArticle.data.title}</h3>
              <p class="text-sm text-lp-muted leading-relaxed line-clamp-2">{featuredArticle.data.description}</p>
            </a>
          )
        }
        <div class={rows}>
          {
            restArticles.map((article) => (
              <a href={`/blog/${article.id}`} class={`${row} reveal-l`}>
                <span class="font-mono text-xs text-lp-muted">{formatShortDateJP(article.data.date)}</span>
                <h4 class="font-display text-lg leading-snug text-lp-text group-hover:text-lp-highlight transition-colors">
                  {article.data.title}
                </h4>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- timeline strip -->
    <div>
      <SectionTitle en="Timeline" ja="経歴" />
      <div class="reveal">
        <Timeline variant="horizontal" />
      </div>
    </div>
  </div>
</section>
