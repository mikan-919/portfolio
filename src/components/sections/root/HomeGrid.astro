---
import { Image } from 'astro:assets'
import Timeline from '@/components/Timeline.astro'
import { formatShortDateJP } from '@/lib/dateUtils'
import type { ArticlesListProps, WorksListProps } from '@/types/collections'

type Props = WorksListProps & ArticlesListProps

const { works, articles }: Props = Astro.props

const skills: Record<string, string[]> = {
  Frontend: ['HTML / CSS', 'JavaScript', 'TypeScript', 'React', 'Astro'],
  Systems: ['Rust', 'Compiler', 'WebAssembly'],
  Tools: ['Bun', 'Git', 'Docker', 'Cloudflare'],
}

const shownWorks = works.slice(0, 3)
const featuredWork = shownWorks[0]
const restWorks = shownWorks.slice(1)

const shownArticles = articles.slice(0, 3)
const featuredArticle = shownArticles[0]
const restArticles = shownArticles.slice(1)

const card = 'bg-lp-surface rounded-lg p-7 md:p-9'
const flat = 'p-7 md:p-9'
---

<section class="w-full bg-lp-bg">
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-14 md:py-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-6 sm:gap-8 sm:[grid-auto-flow:dense]">
    <!-- skills -->
    <div class={`${flat} sm:col-span-2 lg:col-span-12`}>
      <div class="flex items-end justify-between gap-6 mb-6">
        <h2 class="font-display text-2xl leading-none tracking-tight text-lp-text">Skills</h2>
        <a href="/about" class="inline-flex items-center gap-1.5 text-sm text-lp-accent hover:underline w-fit">
          プロフィールを見る →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 sm:gap-8">
        {
          Object.entries(skills).map(([category, tags]) => (
            <div>
              <p class="text-xs text-lp-subtle mb-2">{category}</p>
              <div class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <span class="rounded-full bg-lp-surface-sunken px-2.5 py-0.5 text-xs text-lp-text font-sans">{tag}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- featured work -->
    {
      featuredWork && (
        <a
          href={featuredWork.data.isComingSoon ? undefined : `/works/${featuredWork.id}`}
          class={`${card} sm:col-span-2 lg:col-span-6 flex flex-col gap-4 hover:bg-lp-surface-sunken transition-colors`}
        >
          <div class="min-h-[160px] relative rounded-lg overflow-hidden bg-lp-bg">
            {featuredWork.data.image ? (
              <Image src={featuredWork.data.image} alt={featuredWork.data.title} class="w-full h-full object-cover" />
            ) : (
              <div class="absolute inset-0 opacity-20 bg-[radial-gradient(var(--color-lp-text)_1px,transparent_1px)] bg-[length:16px_16px]" />
            )}
          </div>
          <p class="text-xs text-lp-subtle">Featured project</p>
          <h3 class="font-display text-2xl md:text-3xl leading-tight tracking-tight text-lp-text">{featuredWork.data.title}</h3>
          <p class="text-sm text-lp-muted leading-relaxed line-clamp-2">{featuredWork.data.description}</p>
          <div class="flex justify-between items-center mt-auto">
            <span class="text-xs text-lp-muted">{featuredWork.data.date.getFullYear()}</span>
            <span class="text-sm text-lp-accent">見る →</span>
          </div>
        </a>
      )
    }

    <!-- featured article -->
    {
      featuredArticle && (
        <a href={`/blog/${featuredArticle.id}`} class={`${card} sm:col-span-2 lg:col-span-6 flex flex-col gap-4 lg:justify-between hover:bg-lp-surface-sunken transition-colors`}>
          <div class="flex flex-col gap-4">
            <p class="text-xs text-lp-subtle">Latest post</p>
            <h3 class="font-display text-xl leading-tight tracking-tight text-lp-text">{featuredArticle.data.title}</h3>
            <p class="text-sm text-lp-muted leading-relaxed line-clamp-3">{featuredArticle.data.description}</p>
          </div>
          <span class="text-xs text-lp-muted">{formatShortDateJP(featuredArticle.data.date)}</span>
        </a>
      )
    }

    <!-- rest works -->
    {
      restWorks.map((work) => (
        <a
          href={work.data.isComingSoon ? undefined : `/works/${work.id}`}
          class={`${flat} lg:col-span-3 flex flex-col gap-2 hover:text-lp-accent transition-colors`}
        >
          <p class="text-xs text-lp-subtle">Project</p>
          <h4 class="font-display text-lg leading-tight tracking-tight text-lp-text">{work.data.title}</h4>
          <p class="text-xs text-lp-muted leading-relaxed line-clamp-2">{work.data.description}</p>
        </a>
      ))
    }

    <!-- rest articles -->
    {
      restArticles.map((article) => (
        <a
          href={`/blog/${article.id}`}
          class={`${flat} lg:col-span-3 flex flex-col gap-2 hover:text-lp-accent transition-colors`}
        >
          <p class="text-xs text-lp-subtle">Post</p>
          <h4 class="font-display text-lg leading-tight tracking-tight text-lp-text">{article.data.title}</h4>
          <span class="text-xs text-lp-muted">{formatShortDateJP(article.data.date)}</span>
        </a>
      ))
    }

    <!-- links -->
    <a href="/works" class={`${flat} lg:col-span-3 flex items-center justify-between text-sm text-lp-text hover:text-lp-accent transition-colors`}>
      すべての制作実績 <span>→</span>
    </a>
    <a href="/blog" class={`${flat} lg:col-span-3 flex items-center justify-between text-sm text-lp-text hover:text-lp-accent transition-colors`}>
      すべての記事 <span>→</span>
    </a>

    <!-- timeline strip -->
    <div class={`sm:col-span-2 lg:col-span-12 ${flat} lg:py-9`}>
      <p class="text-xs text-lp-subtle mb-6">Timeline</p>
      <Timeline variant="horizontal" />
    </div>
  </div>
</section>
