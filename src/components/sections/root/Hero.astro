---
import FxCanvas from '@/components/ui/FxCanvas.astro'

const profile = [
  { label: 'Class', value: 'Student Developer' },
  { label: 'Field', value: 'Web / Developer Tools' },
  { label: 'ID', value: '@mikan-919', mono: true },
  { label: 'Since', value: '2021' },
]
---

<!-- ホーム左側のプロフィール票。PC ではステージの高さいっぱいに広げる(6.5rem + 1px = 境界線込みの Header + ステータスバー)。 -->
<FxCanvas>
  <div class="relative flex w-full flex-col justify-center overflow-hidden lg:min-h-[calc(100dvh-6.5rem-1px)]">
    <!-- backdrop: 奥のレイヤー(クラゲの写真と 919)。ポインターの粒子はこの層だけに掛かる。
         傾けたときに板の縁が直線で見えないよう、中身の四辺をぼかす -->
    <div data-fx-layer="-320" class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
      <div
        class="absolute inset-0 overflow-hidden [mask-composite:intersect] [mask-image:linear-gradient(to_right,transparent,#000_6%,#000_86%,transparent),linear-gradient(to_bottom,transparent,#000_8%,#000_84%,transparent)]"
      >
        <span class="absolute -right-4 -bottom-[0.2em] font-display text-[min(48vw,58vh,30rem)] leading-none tracking-tighter text-lp-surface-sunken">
          919
        </span>
        <!-- 黒を透明にした写真。明るい面では淡い水彩のように、暗い面では光って見える -->
        <img
          src="/jellyfish.webp"
          alt=""
          width="450"
          height="1100"
          decoding="async"
          class="absolute -top-[4%] right-[2%] h-[108%] w-auto max-w-none opacity-80 dark:opacity-60 max-lg:-right-[8%] max-lg:opacity-40 max-lg:dark:opacity-30"
        />
      </div>
    </div>

    <div class="relative px-5 sm:px-8 md:px-16 lg:pr-12 xl:pl-[7.5rem] py-6 sm:py-10">
      <div class="flex items-center gap-4">
        <span class="size-2 shrink-0 bg-lp-highlight" aria-hidden="true"></span>
        <span class="label-tech">Profile</span>
        <span class="h-px flex-1 bg-lp-border-subtle" aria-hidden="true"></span>
        <span class="label-tech whitespace-nowrap text-lp-text">Open to opportunities</span>
        <span class="hazard h-2 w-20 max-sm:hidden" aria-hidden="true"></span>
      </div>

      <!-- 名前: 手前のレイヤー。字形が切れないよう上下に padding を取る -->
      <div data-fx-layer="120" class="mt-[min(3vh,3rem)] py-4 lg:mt-[min(5vh,3rem)]">
        <h1
          class="font-display text-[max(2.75rem,min(14vw,12vh,8.5rem))] leading-none font-bold tracking-[0.02em] text-lp-text m-0"
          style="overflow-wrap: anywhere;"
        >
          摘果みかん
        </h1>
        <p class="font-tech font-medium uppercase text-sm sm:text-base tracking-[0.5em] text-lp-highlight mt-4" aria-hidden="true">
          Tekka Mikan
        </p>
      </div>

      <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
        {
          profile.map(({ label, value, mono }) => (
            <>
              <dt class="label-tech self-center">{label}</dt>
              <dd class={`text-lp-text ${mono ? 'font-mono' : ''}`}>{value}</dd>
            </>
          ))
        }
      </dl>

      <!-- 低いモバイル画面ではメニューを優先して紹介文を省く -->
      <p class="text-sm sm:text-base lg:text-lg leading-[1.75] text-lp-muted max-w-[540px] mt-[min(3vh,1.5rem)] max-lg:[@media(max-height:760px)]:hidden">
        Web・言語処理系・開発者ツールを作る学生エンジニア。<br />
        RustやTypeScriptで、設計から中核実装まで取り組んでいます。
      </p>
    </div>
  </div>
</FxCanvas>
