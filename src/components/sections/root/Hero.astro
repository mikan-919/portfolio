---
import FxCanvas from '@/components/ui/FxCanvas.astro'

type Props = {
  projectCount: number
  articleCount: number
}
const { projectCount, articleCount } = Astro.props

const pad = (value: number) => String(value).padStart(2, '0')
const specs = [
  { label: 'Projects', value: pad(projectCount) },
  { label: 'Blog posts', value: pad(articleCount) },
  { label: 'Since', value: '2021' },
]
---

<FxCanvas>
  <div class="relative w-full overflow-hidden">
    <!-- backdrop: 奥のレイヤー -->
    <div data-fx-layer="-320" class="absolute inset-0 overflow-hidden pointer-events-none select-none" aria-hidden="true">
      <div class="grid-dots absolute inset-y-0 right-0 w-2/3 [mask-image:linear-gradient(to_right,transparent,black)] opacity-60"></div>
      <span class="absolute -right-4 -bottom-14 sm:-bottom-20 lg:-bottom-28 font-display text-[15rem] sm:text-[22rem] lg:text-[30rem] leading-none tracking-tighter text-lp-surface-sunken">
        919
      </span>
    </div>

    <div class="relative max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] pt-10 sm:pt-14 pb-14 sm:pb-20">
      <div class="flex items-center gap-4">
        <span class="size-2 shrink-0 bg-lp-highlight" aria-hidden="true"></span>
        <span class="label-tech">Profile</span>
        <span class="h-px flex-1 bg-lp-border-subtle" aria-hidden="true"></span>
        <span class="label-tech text-lp-text">Open to opportunities</span>
        <span class="hazard h-2 w-12 sm:w-20" aria-hidden="true"></span>
      </div>

      <!-- 名前: 手前のレイヤー。字形が切れないよう上下に padding を取る -->
      <div data-fx-layer="120" class="mt-8 sm:mt-12 py-4">
        <h1
          class="font-display text-[52px] min-[360px]:text-[60px] sm:text-[88px] lg:text-[120px] leading-none font-bold tracking-[0.02em] text-lp-text m-0"
          style="overflow-wrap: anywhere;"
        >
          摘果みかん
        </h1>
        <p class="font-tech font-medium uppercase text-sm sm:text-base tracking-[0.5em] text-lp-highlight mt-4" aria-hidden="true">
          Tekka Mikan
        </p>
      </div>

      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
        <dt class="label-tech self-center">Class</dt>
        <dd class="text-lp-text">Student Developer</dd>
        <dt class="label-tech self-center">Field</dt>
        <dd class="text-lp-text">Web / Developer Tools</dd>
        <dt class="label-tech self-center">ID</dt>
        <dd class="font-mono text-lp-text">@mikan-919</dd>
      </dl>

      <p class="text-base sm:text-lg leading-[1.75] text-lp-muted max-w-[540px] mt-6">
        Web・言語処理系・開発者ツールを作る学生エンジニア。<br />
        RustやTypeScriptで、設計から中核実装まで取り組んでいます。
      </p>

      <div class="flex flex-wrap items-center gap-6 mt-8">
        <a href="/works" class="btn-cut">
          <span class="size-1.5 bg-lp-highlight" aria-hidden="true"></span>
          制作実績を見る
        </a>
        <a href="/blog" class="inline-flex items-center min-h-11 text-sm text-lp-text hover:text-lp-highlight transition-colors">
          ブログを読む →
        </a>
      </div>

      <dl class="mt-14 sm:mt-20 flex gap-8 sm:gap-14">
        {
          specs.map(({ label, value }) => (
            <div class="border-l border-lp-border pl-4">
              <dt class="label-tech">{label}</dt>
              <dd class="font-display text-3xl sm:text-5xl leading-none text-lp-text mt-2">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</FxCanvas>
