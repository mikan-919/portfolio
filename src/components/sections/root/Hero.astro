---
type Props = {
  projectCount: number
  articleCount: number
}
const { projectCount, articleCount } = Astro.props
---

<div class="w-full bg-lp-bg">
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-16 md:py-[100px] flex flex-col items-center text-center">
    <!-- badge -->
    <span class="border border-lp-accent bg-lp-accent-subtle text-lp-accent-strong font-mono text-xs tracking-wide px-3 py-1">
      Open to opportunities
    </span>

    <!-- title block -->
    <div class="mt-5 w-full">
      <h1 class="font-new text-[56px] sm:text-[72px] md:text-[96px] leading-none font-bold tracking-tight text-lp-text m-0" style="overflow-wrap: anywhere;">
        摘果みかん
      </h1>
      <div class="h-[5px] bg-lp-accent mt-3 w-full"></div>
    </div>

    <!-- mono subtitle -->
    <p class="font-mono text-sm text-lp-muted tracking-[0.04em] mt-5">
      Student Developer · Web Engineer · @Mikan-919
    </p>

    <!-- bio -->
    <p class="text-lg leading-[1.65] text-lp-muted max-w-[560px] mt-3">
      大学でCSを学びながら、Webを独学中。<br />
      日常とコードのことを書くブログを運営。
    </p>

    <!-- stats row -->
    <div class="mt-9 border-t border-b border-lp-border-subtle py-6 w-full flex justify-center gap-8 sm:gap-16">
      <div class="flex flex-col items-center gap-1">
        <span class="font-new text-[28px] sm:text-[40px] leading-none text-lp-text">{projectCount}</span>
        <span class="font-mono text-[10px] sm:text-[11px] text-lp-muted uppercase tracking-[0.06em]">Projects</span>
      </div>
      <div class="w-px bg-lp-border-subtle"></div>
      <div class="flex flex-col items-center gap-1">
        <span class="font-new text-[28px] sm:text-[40px] leading-none text-lp-text">{articleCount}</span>
        <span class="font-mono text-[10px] sm:text-[11px] text-lp-muted uppercase tracking-[0.06em]">Blog Posts</span>
      </div>
      <div class="w-px bg-lp-border-subtle"></div>
      <div class="flex flex-col items-center gap-1">
        <span class="font-new text-[28px] sm:text-[40px] leading-none text-lp-text">2022</span>
        <span class="font-mono text-[10px] sm:text-[11px] text-lp-muted uppercase tracking-[0.06em]">Since</span>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-wrap justify-center gap-3 mt-8">
      <a
        href="/works"
        class="inline-flex items-center min-h-11 bg-lp-accent text-lp-accent-on font-mono font-semibold text-sm uppercase tracking-[0.06em] px-6 hover:bg-lp-accent-strong transition-colors"
      >
        制作実績を見る
      </a>
      <a
        href="/blog"
        class="inline-flex items-center min-h-11 border-2 border-lp-text text-lp-text font-mono text-sm uppercase tracking-[0.06em] px-6 hover:bg-lp-text hover:text-lp-surface transition-colors"
      >
        ブログを読む
      </a>
    </div>
  </div>
</div>
