---
type Props = {
  projectCount: number
  articleCount: number
}
const { projectCount, articleCount } = Astro.props
---

<div class="w-full bg-lp-bg">
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-14 sm:py-20 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 lg:items-end">
      <!-- statement -->
      <div class="flex flex-col items-start text-left">
        <span class="rounded-full bg-lp-accent-subtle text-lp-accent-strong text-xs px-3 py-1">
          Open to opportunities
        </span>

        <h1 class="font-display text-[56px] sm:text-[72px] lg:text-[88px] leading-none font-bold tracking-tight text-lp-text mt-5 mb-0" style="overflow-wrap: anywhere;">
          摘果みかん
        </h1>

        <p class="text-sm text-lp-muted mt-3">
          Student Developer · Web / Developer Tools · @Mikan-919
        </p>

        <p class="text-lg leading-[1.65] text-lp-muted max-w-[540px] mt-3">
          Web・言語処理系・開発者ツールを作る学生エンジニア。<br />
          RustやTypeScriptで、設計から中核実装まで取り組んでいます。
        </p>

        <div class="flex flex-wrap items-center gap-6 mt-8">
          <a
            href="/works"
            class="inline-flex items-center min-h-11 rounded-full bg-lp-accent text-lp-accent-on text-sm px-5 hover:bg-lp-accent-strong transition-colors"
          >
            制作実績を見る
          </a>
          <a
            href="/blog"
            class="inline-flex items-center min-h-11 text-sm text-lp-text hover:text-lp-accent transition-colors"
          >
            ブログを読む →
          </a>
        </div>
      </div>

      <!-- spec sheet -->
      <div class="flex flex-row lg:flex-col gap-6 lg:gap-4 lg:w-[180px]">
        <div class="flex flex-col lg:flex-row lg:justify-between lg:items-baseline gap-1 lg:gap-0">
          <span class="font-display text-2xl lg:text-xl leading-none text-lp-text">{projectCount}</span>
          <span class="text-xs text-lp-subtle">Projects</span>
        </div>
        <div class="flex flex-col lg:flex-row lg:justify-between lg:items-baseline gap-1 lg:gap-0">
          <span class="font-display text-2xl lg:text-xl leading-none text-lp-text">{articleCount}</span>
          <span class="text-xs text-lp-subtle">Blog Posts</span>
        </div>
        <div class="flex flex-col lg:flex-row lg:justify-between lg:items-baseline gap-1 lg:gap-0">
          <span class="font-display text-2xl lg:text-xl leading-none text-lp-text">2022</span>
          <span class="text-xs text-lp-subtle">Since</span>
        </div>
      </div>
    </div>
  </div>
</div>
