---
import { getCollection } from "astro:content";
import { GITHUB_USERNAME } from "@/lib/constants";
import ContributionGraph from "./ContributionGraph";

const githubStatus = await getCollection('githubStatus').catch(e=>console.log(e));
const totalContributions = githubStatus?.[0]?.data.totalContributions ?? 0
const weeks = githubStatus?.[0]?.data.weeks
---

<div class="bg-lp-surface border border-lp-border-subtle rounded p-8 flex flex-col gap-6">
    <div>
        <p class="font-mono text-xs text-lp-muted uppercase tracking-[0.06em] mb-1">Activity</p>
        <div class="flex items-baseline justify-between">
            <h3 class="font-zen-kaku-gothic-antique text-3xl leading-none tracking-tight text-lp-text">
                GitHub
            </h3>
            <span class="font-zen-kaku-gothic-antique text-3xl leading-none text-lp-accent">
                {totalContributions}
            </span>
        </div>
        <p class="font-mono text-[11px] text-lp-muted mt-1">contributions in {new Date().getFullYear()}</p>
    </div>

    <div class="rounded overflow-hidden">
        <ContributionGraph client:visible {weeks} />
    </div>

    <a
        href={`https://github.com/${GITHUB_USERNAME}`}
        target="_blank"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-lp-accent-strong hover:underline"
    >
        @{GITHUB_USERNAME} on GitHub →
    </a>
</div>
