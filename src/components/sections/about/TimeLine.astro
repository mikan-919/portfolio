---
import { getCollection } from "astro:content"

const timelineData = await getCollection("timeline")
timelineData.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
---

<div>
    <p class="font-mono text-xs text-lp-accent uppercase tracking-widest mb-3">History</p>
    <h3 class="font-display text-4xl leading-none tracking-tight text-lp-dark-text mb-12">
        Timeline
    </h3>
    <div class="pl-0 md:pl-32">
        <div class="border-l border-lp-dark-muted/40 pl-8 py-4 space-y-10">
            {
                timelineData.map((item, index) => (
                    <div class={`relative group ${
                        index === timelineData.length - 1
                            ? "after:absolute after:-left-6 after:-bottom-4 after:-translate-x-[calc(50%+0.5px)] after:w-2 after:h-2 after:bg-lp-dark-muted/40 after:rounded-full"
                            : index === 0 ? "before:absolute before:-left-6 before:-top-4 before:-translate-x-[calc(50%+0.5px)] before:w-2 before:h-2 before:bg-lp-dark-muted/40 before:rounded-full" : ""
                    }`}>
                        <div class="absolute -translate-x-full top-1 -left-10">
                            <span class="font-mono text-xs text-lp-dark-muted group-hover:text-lp-dark-text transition-colors">
                                {item.data.date}
                            </span>
                        </div>
                        <div class="absolute top-2 -left-6 size-3 bg-lp-dark border-2 border-lp-dark-muted/60 group-hover:border-lp-accent transition-colors -translate-x-[calc(50%+0.5px)] rounded-full"></div>
                        <h4 class="font-display text-xl leading-tight tracking-tight text-lp-dark-text">
                            {item.data.title}
                        </h4>
                        <p class="text-sm text-lp-dark-muted leading-relaxed mt-1">
                            {item.data.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</div>
