---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
    id: string;
    tight?: boolean;
} & CollectionEntry<"works">["data"];
const {
    title,
    category,
    tags,
    description,
    image,
    isComingSoon = false,
    id,
    tight,
}: Props = Astro.props;
---

<a
    href={isComingSoon ? undefined : "/works/" + id}
    class={`group flex flex-col bg-lp-surface border border-lp-border-subtle rounded overflow-hidden hover:border-lp-border transition-colors h-full ${isComingSoon ? "pointer-events-none" : ""}`}
>
    <div class="aspect-video relative overflow-hidden bg-lp-surface-sunken">
        {
            image ? (
                <Image
                    src={image}
                    alt={title}
                    class="image-hover-effect w-full h-full object-cover"
                />
            ) : (
                <div class="image-placeholder" />
            )
        }
        {isComingSoon && (
            <div class="absolute inset-0 flex items-center justify-center bg-lp-bg/80">
                <span class="font-mono text-xs text-lp-muted uppercase tracking-widest">Coming Soon</span>
            </div>
        )}
    </div>

    <div class="p-6 flex flex-col gap-2 flex-1">
        <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] text-lp-muted uppercase tracking-[0.06em]">{category}</span>
        </div>
        <h3 class="font-display text-xl leading-tight tracking-tight text-lp-text">
            {title}
        </h3>
        {
            !tight && (
                <p class="text-sm text-lp-muted leading-relaxed line-clamp-2 flex-1">
                    {description}
                </p>
            )
        }
        <div class="flex flex-wrap gap-1.5 mt-2">
            {
                tags.slice(0, 3).map((tag) => (
                    <span class="bg-lp-surface-sunken border border-lp-border-subtle rounded px-2 py-0.5 text-[10px] text-lp-text font-sans">
                        {tag}
                    </span>
                ))
            }
        </div>
    </div>
</a>
