---
type Props = {
    tags: string[];
};

const { tags } = Astro.props;
---

<div class="filter-container">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-display text-4xl leading-none tracking-tight text-lp-text mb-5">
                ALL ARTICLES
            </h2>
            <div class="flex flex-wrap gap-2" id="filter-container">
                {
                    tags.map((tag) => (
                        <button
                            data-filter={tag}
                            class={`filter-btn ${tag === 'All' ? 'bg-lp-accent text-lp-accent-on border-transparent' : ''}`}
                        >
                            #{tag}
                        </button>
                    ))
                }
            </div>
        </div>
    </div>
</div>
