---
import { Image } from "astro:assets";
import { formatFullDate } from "@/lib/dateUtils";
import type { ArticleCardProps } from "@/types/cards";

type Props = ArticleCardProps

const { title, summary, tags, image, date, slug }: Props = Astro.props;

const formattedDate = formatFullDate(date)
---

<a
    href={"/blog/" + slug}
    class="group flex flex-col bg-lp-surface border border-lp-border-subtle rounded overflow-hidden hover:border-lp-border transition-colors h-full"
>
    <div class="aspect-video relative overflow-hidden bg-lp-surface-sunken">
        {
            image ? (
                <Image
                    src={image}
                    alt={title}
                    class="image-hover-effect w-full h-full object-cover"
                />
            ) : (
                <div class="image-placeholder" />
            )
        }
    </div>

    <div class="p-6 flex flex-col gap-2 flex-1">
        <span class="font-mono text-[10px] text-lp-muted">{formattedDate}</span>
        <h3 class="font-display text-xl leading-tight tracking-tight text-lp-text">
            {title}
        </h3>
        <p class="text-sm text-lp-muted leading-relaxed line-clamp-3 flex-1">
            {summary}
        </p>
        <div class="flex flex-wrap gap-1.5 mt-2">
            {
                tags.slice(0, 3).map((tag) => (
                    <span class="bg-lp-surface-sunken border border-lp-border-subtle rounded px-2 py-0.5 text-[10px] text-lp-text font-sans">
                        #{tag}
                    </span>
                ))
            }
        </div>
    </div>
</a>
