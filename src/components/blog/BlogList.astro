---
import type { ArticlesListProps } from "@/types/collections";
import ArticleCard from "./ArticleCard.astro";

type Props = ArticlesListProps;

const { articles } = Astro.props;
---

<div class="px-8 md:px-16 lg:px-[7.5rem] py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
            articles.map((article) => (
                <div
                    class="article-item h-full"
                    data-tags={JSON.stringify(article.data.tags)}
                >
                    <ArticleCard {...article.data} slug={article.id} />
                </div>
            ))
        }
    </div>
    <div id="no-results" class="hidden py-16 text-center font-mono text-sm text-lp-muted">
        No articles found with this tag.
    </div>
</div>
