---
import { sortByDateAscending } from "@/lib/collectionUtils";
import type { ArticlesListProps } from "@/types/collections";

type Props = ArticlesListProps;

const { articles } = Astro.props;

const totalArticles = articles.length

const sortedArticles = sortByDateAscending(articles)

let articlesPerMonth = 0;
if (sortedArticles.length > 0) {
    const firstDate = sortedArticles[0].data.date;
    const lastDate = new Date();

    const monthsDiff =
        (lastDate.getFullYear() - firstDate.getFullYear()) * 12 +
        (lastDate.getMonth() - firstDate.getMonth()) +
        1;

    articlesPerMonth =
        monthsDiff > 0 ? totalArticles / monthsDiff : totalArticles;
}
---

<div class="section-header">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
            <p class="font-mono text-xs text-lp-muted uppercase tracking-[0.06em] mb-2">
                BLOG ARCHIVE
            </p>
            <h1 class="font-display text-6xl md:text-8xl leading-none tracking-tight text-lp-text">
                BLOG.
            </h1>
        </div>

        <div class="hidden md:flex gap-12 text-right">
            <div>
                <p class="font-display text-[40px] leading-none text-lp-text">{totalArticles}</p>
                <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em] mt-1">TOTAL ARTICLES</p>
            </div>
            <div class="w-px bg-lp-border-subtle"></div>
            <div>
                <p class="font-display text-[40px] leading-none text-lp-text">{articlesPerMonth.toFixed(1)}</p>
                <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em] mt-1">ARTICLES / MONTH</p>
            </div>
        </div>
    </div>
</div>
