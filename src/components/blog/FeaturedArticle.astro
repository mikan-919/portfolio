---
import { Image } from "astro:assets";
import { formatShortDateJP } from "@/lib/dateUtils";
import type { ArticleCardProps } from "@/types/cards";

type Props = ArticleCardProps

const { title, summary, tags, image, date, slug } = Astro.props;

const formattedDate = formatShortDateJP(date)
---

<div class="bg-lp-accent-subtle border border-lp-border-subtle rounded overflow-hidden">
    <div class="px-6 py-3 border-b border-lp-border-subtle flex justify-between items-center">
        <span class="font-mono text-xs text-lp-accent-strong uppercase tracking-widest">Latest Article</span>
        <span class="font-mono text-xs text-lp-muted">{formattedDate}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2">
        <!-- 左：画像エリア -->
        <div class="aspect-video relative group overflow-hidden bg-lp-surface-sunken">
            {
                image ? (
                    <Image
                        src={image}
                        alt={title}
                        class="image-hover-effect w-full h-full object-cover"
                    />
                ) : (
                    <div class="image-placeholder" />
                )
            }
            <a
                href={"/blog/" + slug}
                class="hover-button-overlay"
            >
                <span class="btn-brutal">
                    Read Article
                </span>
            </a>
        </div>

        <!-- 右：詳細エリア -->
        <div class="px-8 py-10 flex flex-col justify-between">
            <div>
                <h3 class="font-display text-3xl leading-tight tracking-tight text-lp-text mb-3">
                    {title}
                </h3>
                <p class="text-sm text-lp-muted leading-relaxed">
                    {summary}
                </p>
            </div>
            <div class="mt-6">
                <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em] mb-2">Tags</p>
                <ul class="flex flex-wrap gap-2">
                    {
                        tags.map((tag) => (
                            <li class="bg-lp-surface border border-lp-border-subtle rounded px-2.5 py-0.5 text-xs text-lp-text font-sans">
                                #{tag}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
