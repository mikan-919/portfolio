---
import { getCollection } from 'astro:content'
import Hero from '@/components/sections/root/Hero.astro'
import HomeGrid from '@/components/sections/root/HomeGrid.astro'
import Layout from '@/layouts/Layout.astro'
import { sortByDateDescending } from '@/lib/collectionUtils'

const allWorks = await getCollection('works')
const sortedWorks = sortByDateDescending(allWorks)
const allArticles = await getCollection('articles')
const sortedArticles = sortByDateDescending(allArticles)
---

<Layout
  description="Web・言語処理系・開発者ツールを作る学生エンジニア、摘果みかんのポートフォリオ。制作実績と技術ブログを掲載。"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: '摘果みかん',
    alternateName: 'mikan-919',
    url: new URL('/', Astro.site ?? Astro.url).href,
    sameAs: ['https://github.com/mikan-919', 'https://twitter.com/mikan_919_main'],
    jobTitle: 'Student Developer',
    knowsAbout: ['Web Development', 'Rust', 'TypeScript', 'Compilers', 'Developer Tools'],
  }}
>
  <Hero projectCount={allWorks.length} articleCount={allArticles.length} />
  <HomeGrid works={sortedWorks} articles={sortedArticles} />
</Layout>
