---
import { getCollection } from 'astro:content'
import Hero from '@/components/sections/root/Hero.astro'
import HomeMenu from '@/components/sections/root/HomeMenu.astro'
import Layout from '@/layouts/Layout.astro'
import { sortByDateDescending } from '@/lib/collectionUtils'

const allWorks = await getCollection('works')
const sortedWorks = sortByDateDescending(allWorks)
const allArticles = await getCollection('articles')
const sortedArticles = sortByDateDescending(allArticles)
---

<Layout
  description="AIエージェントが書くコードを、型と権限と計測で確かめる仕組みを作る学生エンジニア、摘果みかんのポートフォリオ。制作実績と技術ブログを掲載。"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: '摘果みかん',
    alternateName: 'mikan-919',
    url: new URL('/', Astro.site ?? Astro.url).href,
    sameAs: ['https://github.com/mikan-919', 'https://twitter.com/mikan_919_main', 'https://zenn.dev/mikan_919'],
    jobTitle: 'Student Developer',
    knowsAbout: ['Type Systems', 'Compilers', 'AI Agents', 'Developer Tools', 'Rust', 'TypeScript'],
  }}
>
  <!-- 左にプロフィール、右にメニュー。モバイルでは縦に積み、メニューが残りの高さを埋める。
       入場や傾きで外へ出た分は切り、main にスクロールバーを出さない -->
  <div class="grid min-h-full grid-rows-[auto_1fr] overflow-hidden lg:h-full lg:grid-cols-[minmax(0,1fr)_minmax(0,min(34rem,42vw))] lg:grid-rows-1">
    <Hero />
    <HomeMenu works={sortedWorks} articles={sortedArticles} />
  </div>
</Layout>
