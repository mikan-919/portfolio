---
import { getCollection } from 'astro:content'
import Archive from '@/components/archive/Archive.astro'
import GitHubCTA from '@/components/works/GithubCTA.astro'
import Layout from '@/layouts/Layout.astro'
import { sortByDateDescending } from '@/lib/collectionUtils'

const allWorks = await getCollection('works')
const sortedWorks = sortByDateDescending(allWorks)
---

<Layout title="Works" description="摘果みかんの制作実績一覧。Web サイト・アプリの開発事例。">
  <main>
    <Archive kind="work" entries={sortedWorks} />
    <GitHubCTA />
  </main>
</Layout>
