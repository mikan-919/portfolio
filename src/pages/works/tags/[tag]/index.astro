---
import { getCollection } from 'astro:content'
import Archive from '@/components/archive/Archive.astro'
import Layout from '@/layouts/Layout.astro'
import { sortByDateDescending } from '@/lib/collectionUtils'
export const prerender = true

export async function getStaticPaths() {
  const works = await getCollection('works')
  const allTags = works.flatMap((w) => w.data.tags)
  const uniqueTags = [...new Set(allTags)]
  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { tag, works: sortByDateDescending(works.filter((w) => w.data.tags.includes(tag))) },
  }))
}

const { tag, works } = Astro.props
---

<Layout title={`#${tag}`} description={`#${tag} の作品一覧`}>
  <Archive kind="work" entries={works} tag={tag} />
</Layout>
