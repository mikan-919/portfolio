---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import ExternalLink from '@lucide/astro/icons/external-link'
import Github from 'simple-icons-astro/Github'
import CoverImage from '@/components/ui/CoverImage.astro'
import PostNav from '@/components/ui/PostNav.astro'
import ReaderScreen from '@/components/ui/ReaderScreen.astro'
import Tags from '@/components/ui/Tags.astro'
import Layout from '@/layouts/Layout.astro'
import { sortByDateDescending } from '@/lib/collectionUtils'
import { coverUrl } from '@/lib/cover'
import { formatMonthYear } from '@/lib/dateUtils'
export const prerender = true
export async function getStaticPaths() {
  const works = await getCollection('works')
  const sortedWorks = sortByDateDescending(works)
  return sortedWorks.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevWork: sortedWorks[index - 1] ?? null,
      nextWork: sortedWorks[index + 1] ?? null,
    },
  }))
}

type Props = {
  entry: CollectionEntry<'works'>
  prevWork: CollectionEntry<'works'> | null
  nextWork: CollectionEntry<'works'> | null
}

const { entry, prevWork, nextWork } = Astro.props
const { Content } = await render(entry)
const formattedDate = formatMonthYear(entry.data.date)
const link = 'inline-flex min-h-11 items-center gap-1.5 text-sm text-lp-highlight hover:underline lg:min-h-0'
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={`/og/works/${entry.id}.png`}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: entry.data.title,
    description: entry.data.description,
    image: new URL(`/og/works/${entry.id}.png`, Astro.site ?? Astro.url).href,
    dateCreated: entry.data.date.toISOString(),
    creator: {
      '@type': 'Person',
      name: '摘果みかん',
      url: new URL('/about', Astro.site ?? Astro.url).href,
    },
    url: new URL(`/works/${entry.id}`, Astro.site ?? Astro.url).href,
    sameAs: [entry.data.link, entry.data.github].filter(Boolean),
    keywords: entry.data.tags.join(', '),
  }}
>
  <ReaderScreen>
    <Fragment slot="aside">
      <div data-flip-page="cover" class="relative shrink-0 overflow-hidden bg-lp-dark max-lg:h-36 lg:h-[40%] lg:min-h-48">
        <CoverImage src={entry.data.image ?? coverUrl('works', entry.id)} alt="" class="absolute inset-0 size-full object-cover opacity-45" />
        <div class="absolute inset-0 bg-linear-to-t from-lp-dark via-lp-dark/50 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-x-0 bottom-0 space-y-2 px-5 pb-4 sm:px-8 md:px-16 lg:px-10 lg:pb-6 xl:pl-[7.5rem]">
          <div class="flex items-center gap-3">
            <span class="bg-lp-dark-text px-2 py-0.5 font-tech text-[11px] font-medium uppercase tracking-[0.14em] text-lp-dark">
              {entry.data.category}
            </span>
            {entry.data.isComingSoon && <span class="label-tech text-lp-dark-muted">Coming soon</span>}
            <span class="ml-auto font-mono text-xs text-lp-dark-muted">{formattedDate}</span>
          </div>
          <h1 data-flip-page="title" class="font-display text-2xl leading-tight text-lp-dark-text line-clamp-2 lg:text-4xl" style="overflow-wrap: anywhere;">
            {entry.data.title}
          </h1>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 px-5 sm:px-8 md:px-16 lg:flex-col lg:items-stretch lg:gap-8 lg:px-10 lg:py-8 xl:pl-[7.5rem]">
        <div class="hidden lg:block">
          <p class="label-tech">Project type</p>
          <p class="mt-2 font-medium text-lp-text">{entry.data.role || '—'}</p>
        </div>
        <div>
          <p class="label-tech hidden lg:block">Links</p>
          <div class="flex flex-wrap gap-x-6 lg:mt-2 lg:flex-col lg:gap-1.5">
            {
              entry.data.link && (
                <a href={entry.data.link} target="_blank" rel="noopener noreferrer" class={link}>
                  Visit site
                  <ExternalLink class="size-3.5" />
                </a>
              )
            }
            {
              entry.data.github && (
                <a href={entry.data.github} target="_blank" rel="noopener noreferrer" class={link}>
                  GitHub
                  <Github class="size-3.5" />
                </a>
              )
            }
            {
              entry.data.githubVisibility === 'private' && (
                <span class="inline-flex min-h-11 items-center gap-1.5 text-sm text-lp-muted lg:min-h-0">
                  GitHub · Private
                  <Github class="size-3.5" />
                </span>
              )
            }
            {
              !entry.data.link && !entry.data.github && entry.data.githubVisibility !== 'private' && (
                <span class="text-sm text-lp-muted max-lg:hidden">—</span>
              )
            }
          </div>
        </div>
      </div>
    </Fragment>

    <Content />

    {
      entry.data.gallery && entry.data.gallery.length > 0 && (
        <section class="not-prose mt-10">
          <p class="label-tech">Gallery</p>
          {entry.data.gallery.map((img, index) => (
            <Image src={img} alt={`${entry.data.title}のスクリーンショット ${index + 1}`} class="mt-4" />
          ))}
        </section>
      )
    }

    <footer class="not-prose mt-12 break-inside-avoid border-t border-lp-border-subtle pt-6">
      <p class="label-tech">Tech stack</p>
      <div class="mt-3">
        <Tags tags={entry.data.tags} link={(tag) => `/works/tags/${tag}`} />
      </div>
      <PostNav
        prev={prevWork ? { href: `/works/${prevWork.id}`, title: prevWork.data.title } : null}
        next={nextWork ? { href: `/works/${nextWork.id}`, title: nextWork.data.title } : null}
        prevLabel="← Newer"
        nextLabel="Older →"
        backHref="/works"
        backLabel="制作実績の一覧へ"
      />
    </footer>
  </ReaderScreen>
</Layout>
