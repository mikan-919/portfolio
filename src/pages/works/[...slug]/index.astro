---
import { Image } from "astro:assets";
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from "astro:content";
import ExternalLink from "@lucide/astro/icons/external-link";
import Github from "simple-icons-astro/Github";
import PostNav from "@/components/ui/PostNav.astro";
import Tags from "@/components/ui/Tags.astro";
import Layout from "@/layouts/Layout.astro";
import { sortByDateDescending } from "@/lib/collectionUtils";
import { formatMonthYear } from "@/lib/dateUtils";
export const prerender = true
export async function getStaticPaths() {
    const works = await getCollection('works')
    const sortedWorks = sortByDateDescending(works)
    return sortedWorks.map((entry, index) => ({
        params: { slug: entry.id },
        props: {
            entry,
            prevWork: sortedWorks[index - 1] ?? null,
            nextWork: sortedWorks[index + 1] ?? null,
        },
    }))
}

type Props = {
    entry: CollectionEntry<'works'>
    prevWork: CollectionEntry<'works'> | null
    nextWork: CollectionEntry<'works'> | null
}

const { entry, prevWork, nextWork } = Astro.props
const { Content } = await render(entry)
const formattedDate = formatMonthYear(entry.data.date)
---

<Layout
    title={entry.data.title}
    description={entry.data.description}
    ogImage={`/og/works/${entry.id}.png`}
>
    <!-- Header Image & Title -->
    <div class="w-full relative h-80 md:h-[28rem] overflow-hidden">
        {
            entry.data.image ? (
                <Image
                    src={entry.data.image}
                    alt={entry.data.title}
                    class="w-full h-full object-cover"
                />
            ) : (
                <div class="w-full h-full bg-lp-surface-sunken">
                    <div class="image-placeholder" />
                </div>
            )
        }
        <div class="absolute inset-0 bg-lp-dark/60">
            <div class="absolute bottom-0 left-0 w-full px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-10">
                <div class="space-y-3">
                    <div class="flex items-center gap-3">
                        <span class="rounded-full bg-lp-accent text-lp-accent-on text-xs font-medium px-3 py-1">
                            {entry.data.category}
                        </span>
                        {entry.data.isComingSoon && (
                            <span class="rounded-full bg-lp-surface text-lp-text text-xs font-medium px-3 py-1">
                                Coming Soon
                            </span>
                        )}
                    </div>
                    <h1 class="font-display text-3xl sm:text-4xl md:text-6xl leading-none tracking-tight text-lp-dark-text" style="overflow-wrap: anywhere;">
                        {entry.data.title}
                    </h1>
                    <p class="font-mono text-xs text-lp-dark-muted">
                        {formattedDate}
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Grid -->
    <div class="w-full border-b border-lp-border">
        <div class="px-5 sm:px-8 md:px-16 lg:px-[7.5rem]">
            <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-lp-border py-8 gap-0">
                <div class="py-6 md:py-0 md:pr-8 space-y-2">
                    <p class="text-xs text-lp-subtle">Project Type</p>
                    <p class="font-sans text-lp-text font-medium">
                        {entry.data.role || "—"}
                    </p>
                </div>
                <div class="py-6 md:py-0 md:px-8 space-y-2">
                    <p class="text-xs text-lp-subtle">Links</p>
                    <div class="flex flex-col gap-1.5">
                        {entry.data.link ? (
                            <a
                                href={entry.data.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm text-lp-accent hover:underline flex items-center gap-1.5"
                            >
                                Visit Site
                                <ExternalLink class="size-3.5" />
                            </a>
                        ) : (
                            <span class="text-sm text-lp-muted">—</span>
                        )}
                        {entry.data.github && (
                            <a
                                href={entry.data.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm text-lp-accent hover:underline flex items-center gap-1.5"
                            >
                                GitHub
                                <Github class="size-3.5" />
                            </a>
                        )}
                    </div>
                </div>
                <div class="py-6 md:py-0 md:pl-8 space-y-2">
                    <p class="text-xs text-lp-subtle">Tech Stack</p>
                    <Tags tags={entry.data.tags} link={(tag) => `/works/tags/${tag}`} />
                </div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="w-full border-b border-lp-border">
        <div class="px-5 sm:px-8 md:px-16 lg:px-[7.5rem]">
            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_1fr] min-h-[50vh] divide-x-0 lg:divide-x divide-lp-border">
                <div class="py-8 lg:py-12 lg:pr-12 prose prose-neutral max-w-none
                    prose-headings:font-display prose-headings:tracking-tight prose-headings:text-lp-text
                    prose-p:text-lp-muted prose-p:leading-relaxed
                    prose-a:text-lp-accent prose-a:decoration-1 prose-a:underline-offset-2
                    prose-blockquote:border-l-4 prose-blockquote:border-lp-accent prose-blockquote:bg-lp-accent-subtle prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:not-italic
                    prose-img:rounded-lg prose-img:border prose-img:border-lp-border">
                    <Content />
                </div>
                <div class="py-8 lg:py-12 lg:pl-10 border-t lg:border-t-0 border-lp-border">
                    {
                        entry.data.gallery && entry.data.gallery.length > 0 ? (
                            <div class="flex flex-col gap-4">
                                <p class="text-xs text-lp-subtle">Gallery</p>
                                {entry.data.gallery.map((img) => (
                                    <Image
                                        src={img}
                                        alt=""
                                        class="w-full rounded-lg border border-lp-border"
                                    />
                                ))}
                            </div>
                        ) : (
                            <div class="h-full flex items-center justify-center opacity-30">
                                <div class="text-center">
                                    <span class="block text-4xl mb-2">📷</span>
                                    <span class="font-mono text-xs text-lp-muted">No Gallery Images</span>
                                </div>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <PostNav
        prev={prevWork ? { href: `/works/${prevWork.id}`, title: prevWork.data.title } : null}
        next={nextWork ? { href: `/works/${nextWork.id}`, title: nextWork.data.title } : null}
        backHref="/works"
        backLabel="Back to Works"
        newerEmptyLabel="No newer work"
        olderEmptyLabel="No older work"
    />
</Layout>
