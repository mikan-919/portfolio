---
import Github from "@/components/sections/about/Github.astro"
import InfoGrid from "@/components/sections/about/InfoGrid.astro";
import TimeLine from "@/components/sections/about/TimeLine.astro";
import Values from "@/components/sections/about/Values.astro"
import Layout from "@/layouts/Layout.astro";
import myInfo from '@/content/data/my-info.json'
const { profile } = myInfo
---

<Layout title="Portfoliooo | About" description="摘果みかんのプロフィール・学習中の技術・GitHub Activity。">
    <!-- Page Header -->
    <div class="w-full border-b border-lp-border">
        <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-16">
            <p class="font-mono text-xs text-lp-muted uppercase tracking-[0.06em] mb-3">Profile</p>
            <h1 class="font-display text-6xl md:text-8xl leading-none tracking-tight text-lp-text mb-4">
                About.
            </h1>
            <div class="h-[3px] bg-lp-accent w-24 rounded-sm"></div>
        </div>
    </div>

    <!-- Bio + Info Grid -->
    <div class="w-full border-b border-lp-border">
        <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-12">
            <div class="grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-12">
                <div class="flex flex-col gap-6">
                    <div>
                        <h2 class="font-display text-4xl leading-tight tracking-tight text-lp-text">{profile.name}</h2>
                        <p class="font-mono text-xs text-lp-muted mt-1">{profile.handle}</p>
                    </div>
                    <p class="text-sm text-lp-muted leading-relaxed" set:html={profile.bio.replace(/\n/g, '<br />')} />
                    <p class="font-mono text-[11px] text-lp-subtle">LAST UPDATED: {profile.lastUpdated}</p>
                </div>
                <div>
                    <InfoGrid />
                </div>
            </div>
        </div>
    </div>

    <!-- GitHub Activity + Values -->
    <div class="w-full border-b border-lp-border">
        <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-12">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <Github />
                <Values />
            </div>
        </div>
    </div>

    <!-- Timeline -->
    <div class="w-full bg-lp-dark border-b border-lp-border">
        <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem] py-16">
            <TimeLine />
        </div>
    </div>
</Layout>
