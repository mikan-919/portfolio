---
import Github from "@/components/sections/about/Github.astro"
import InfoGrid from "@/components/sections/about/InfoGrid.astro"
import Values from "@/components/sections/about/Values.astro"
import Timeline from "@/components/Timeline.astro"
import myInfo from '@/content/data/my-info.json'
import Layout from "@/layouts/Layout.astro"

const { profile } = myInfo

const cell = 'bg-lp-surface rounded-xl border border-lp-border-subtle p-6 md:p-8'
---

<Layout title="About" description="摘果みかんのプロフィール・学習中の技術・GitHub Activity。" ogImage="/og/site/about.png">
    <!-- Page header -->
    <div class="w-full border-b border-lp-border bg-lp-bg">
        <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-16">
            <p class="text-xs text-lp-subtle mb-3">Profile</p>
            <h1 class="font-display text-5xl sm:text-6xl md:text-8xl leading-none tracking-tight text-lp-text" style="overflow-wrap: anywhere;">
                About
            </h1>
        </div>
    </div>

    <!-- bento grid -->
    <section class="w-full bg-lp-bg">
        <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-14 md:py-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 sm:[grid-auto-flow:dense]">
            <!-- profile / bio -->
            <div class={`${cell} sm:col-span-2 lg:row-span-2 flex flex-col gap-4`}>
                <h2 class="font-display text-2xl md:text-3xl leading-tight tracking-tight text-lp-text">{profile.name}</h2>
                <p class="font-mono text-xs text-lp-muted -mt-2">{profile.handle}</p>
                <p class="text-sm text-lp-muted leading-relaxed" set:html={profile.bio.replace(/\n/g, '<br />')} />
                <p class="text-xs text-lp-subtle mt-auto">Last updated {profile.lastUpdated}</p>
            </div>

            <!-- github -->
            <div class={`${cell} lg:row-span-2`}>
                <Github />
            </div>

            <!-- values -->
            <div class={`${cell} lg:row-span-2`}>
                <Values />
            </div>

            <!-- learning / interests -->
            <div class={`sm:col-span-2 lg:col-span-4 ${cell}`}>
                <InfoGrid />
            </div>
        </div>
    </section>

    <!-- timeline -->
    <div class="w-full bg-lp-dark">
        <div class="max-w-[1200px] mx-auto px-5 sm:px-8 md:px-16 lg:px-[7.5rem] py-16">
            <p class="text-xs text-lp-accent mb-3">History</p>
            <h3 class="font-display text-3xl md:text-4xl leading-none tracking-tight text-lp-dark-text mb-12">
                Timeline
            </h3>
            <Timeline variant="vertical" dark />
        </div>
    </div>
</Layout>
