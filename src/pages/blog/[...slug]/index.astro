---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from 'astro:content'
import TableOfContents from "@/components/blog/TableOfContents.tsx";
import Tags from "@/components/ui/Tags.astro";
import Layout from "@/layouts/Layout.astro";
import { sortByDateDescending } from "@/lib/collectionUtils";
import { formatShortDateJP } from "@/lib/dateUtils";

export async function getStaticPaths() {
    const articles = await getCollection('articles')
    const sortedPosts = sortByDateDescending(articles)
    return sortedPosts.map((entry, index) => ({
        params: { slug: entry.id },
        props: {
            entry,
            prevPost: sortedPosts[index - 1] ?? null,
            nextPost: sortedPosts[index + 1] ?? null,
        },
    }))
}

type Props = {
    entry: CollectionEntry<'articles'>
    prevPost: CollectionEntry<'articles'> | null
    nextPost: CollectionEntry<'articles'> | null
}

const { entry, prevPost, nextPost } = Astro.props
const { Content, headings } = await render(entry)
const formattedDate = formatShortDateJP(entry.data.date)
---

<Layout
    title={`Portfoliooo | ${entry.data.title}`}
    description={entry.data.description}
>
    <!-- Header Image & Title -->
    <div class="w-full relative h-80 md:h-[28rem] overflow-hidden">
        {
            entry.data.image ? (
                <Image
                    src={entry.data.image}
                    alt={entry.data.title}
                    class="w-full h-full object-cover"
                />
            ) : (
                <div class="w-full h-full bg-lp-surface-sunken">
                    <div class="image-placeholder" />
                </div>
            )
        }
        <div class="absolute inset-0 bg-lp-dark/60">
            <div class="absolute bottom-0 left-0 w-full px-8 md:px-16 lg:px-[7.5rem] py-10">
                <div class="max-w-[1200px] mx-auto space-y-3">
                    <h1 class="font-display text-4xl md:text-6xl leading-none tracking-tight text-lp-dark-text">
                        {entry.data.title}
                    </h1>
                    <p class="font-mono text-xs text-lp-dark-muted">
                        {formattedDate}
                    </p>
                    <p class="text-sm text-lp-dark-text/80 max-w-xl leading-relaxed">
                        {entry.data.description}
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary & Tags -->
    <div class="w-full border-b border-lp-border">
        <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem]">
            <div class="grid grid-cols-1 md:grid-cols-[3fr_1fr] divide-y md:divide-y-0 md:divide-x divide-lp-border">
                <div class="py-8 md:pr-12 space-y-2">
                    <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em]">Summary</p>
                    <p class="text-sm text-lp-muted leading-relaxed">
                        {entry.data?.summary || "No summary available."}
                    </p>
                </div>
                <div class="py-8 md:pl-10 space-y-2">
                    <p class="font-mono text-[11px] text-lp-muted uppercase tracking-[0.06em]">Tags</p>
                    <Tags tags={entry.data.tags} link={(tag) => `/blog?tag=${tag}`} />
                </div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="w-full border-b border-lp-border">
        <div class="max-w-[1200px] mx-auto px-8 md:px-16 lg:px-[7.5rem]">
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_4fr] min-h-[calc(100vh-600px)] divide-x-0 lg:divide-x divide-lp-border">
                <!-- 目次 (PCのみ表示) -->
                <aside class="hidden lg:block py-12 pr-10">
                    <TableOfContents client:idle headings={headings} />
                </aside>
                <div class="py-12 lg:pl-12 prose prose-neutral max-w-none
                    prose-headings:font-display prose-headings:tracking-tight prose-headings:text-lp-text
                    prose-p:text-lp-muted prose-p:leading-relaxed
                    prose-a:text-lp-accent-strong prose-a:decoration-1 prose-a:underline-offset-2
                    prose-blockquote:border-l-4 prose-blockquote:border-lp-accent prose-blockquote:bg-lp-accent-subtle prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:not-italic
                    prose-img:rounded prose-img:border prose-img:border-lp-border
                    prose-code:text-lp-accent-strong prose-code:bg-lp-accent-subtle prose-code:px-1 prose-code:py-0.5 prose-code:rounded">
                    <Content />
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <div class="w-full border-b border-lp-border">
        <div class="grid grid-cols-3 divide-x divide-lp-border">
                {prevPost ? (
                    <a href={`/blog/${prevPost.id}`} class="flex flex-col justify-center py-8 pr-8 pl-8 md:pl-16 lg:pl-[7.5rem] hover:bg-lp-surface-sunken transition-colors">
                        <span class="font-mono text-[10px] text-lp-muted uppercase tracking-widest mb-1">&lt; Newer</span>
                        <span class="text-sm text-lp-text font-medium leading-tight line-clamp-2">{prevPost.data.title}</span>
                    </a>
                ) : (
                    <div class="flex flex-col justify-center py-8 pr-8 pl-8 md:pl-16 lg:pl-[7.5rem] opacity-30 select-none">
                        <span class="font-mono text-[10px] text-lp-muted uppercase tracking-widest mb-1">&lt; Newer</span>
                        <span class="text-sm text-lp-text font-medium">No newer posts</span>
                    </div>
                )}
                <a href="/blog" class="flex items-center justify-center py-8 hover:bg-lp-surface-sunken transition-colors font-mono text-xs text-lp-muted hover:text-lp-text uppercase tracking-widest">
                    Back to Blog
                </a>
                {nextPost ? (
                    <a href={`/blog/${nextPost.id}`} class="flex flex-col justify-center items-end text-right py-8 pl-8 pr-8 md:pr-16 lg:pr-[7.5rem] hover:bg-lp-surface-sunken transition-colors">
                        <span class="font-mono text-[10px] text-lp-muted uppercase tracking-widest mb-1">Older &gt;</span>
                        <span class="text-sm text-lp-text font-medium leading-tight line-clamp-2">{nextPost.data.title}</span>
                    </a>
                ) : (
                    <div class="flex flex-col justify-center items-end text-right py-8 pl-8 pr-8 md:pr-16 lg:pr-[7.5rem] opacity-30 select-none">
                        <span class="font-mono text-[10px] text-lp-muted uppercase tracking-widest mb-1">Older &gt;</span>
                        <span class="text-sm text-lp-text font-medium">No older posts</span>
                    </div>
                )}
        </div>
    </div>
</Layout>
