---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import CoverImage from '@/components/ui/CoverImage.astro'
import PostNav from '@/components/ui/PostNav.astro'
import ReaderScreen from '@/components/ui/ReaderScreen.astro'
import Tags from '@/components/ui/Tags.astro'
import Layout from '@/layouts/Layout.astro'
import { sortByDateDescending } from '@/lib/collectionUtils'
import { coverUrl } from '@/lib/cover'
import { formatShortDateJP } from '@/lib/dateUtils'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  const sortedPosts = sortByDateDescending(articles)
  return sortedPosts.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevPost: sortedPosts[index - 1] ?? null,
      nextPost: sortedPosts[index + 1] ?? null,
    },
  }))
}

type Props = {
  entry: CollectionEntry<'articles'>
  prevPost: CollectionEntry<'articles'> | null
  nextPost: CollectionEntry<'articles'> | null
}

const { entry, prevPost, nextPost } = Astro.props
const { Content, headings } = await render(entry)
const toc = headings.filter((h) => h.depth > 1 && h.depth < 4)
const formattedDate = formatShortDateJP(entry.data.date)
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={`/og/blog/${entry.id}.png`}
  ogType="article"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    image: new URL(`/og/blog/${entry.id}.png`, Astro.site ?? Astro.url).href,
    datePublished: entry.data.date.toISOString(),
    author: {
      '@type': 'Person',
      name: '摘果みかん',
      url: new URL('/about', Astro.site ?? Astro.url).href,
    },
    mainEntityOfPage: new URL(`/blog/${entry.id}`, Astro.site ?? Astro.url).href,
    keywords: entry.data.tags.join(', '),
  }}
>
  <ReaderScreen>
    <Fragment slot="aside">
      <div data-flip-page="cover" class="relative shrink-0 overflow-hidden bg-lp-dark max-lg:h-36 lg:h-[34%] lg:min-h-40">
        <CoverImage
          src={entry.data.image ?? coverUrl('articles', entry.id)}
          alt=""
          class="absolute inset-0 size-full object-cover opacity-45"
        />
        <div class="absolute inset-0 bg-linear-to-t from-lp-dark via-lp-dark/50 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-x-0 bottom-0 space-y-2 px-5 pb-4 sm:px-8 md:px-16 lg:px-10 lg:pb-6 xl:pl-[7.5rem]">
          <p class="font-mono text-xs text-lp-dark-muted">{formattedDate}</p>
          <h1
            data-flip-page="title"
            class="font-display text-2xl leading-tight text-lp-dark-text line-clamp-2 lg:text-3xl lg:line-clamp-4"
            style="overflow-wrap: anywhere;"
          >
            {entry.data.title}
          </h1>
        </div>
      </div>
      <!-- 目次は欄の残りの高さに収め、あふれる分はバーを出さずに目次の中だけでスクロールする(下端をぼかす) -->
      <div class="hidden min-h-0 flex-1 flex-col gap-6 px-10 py-6 lg:flex xl:pl-[7.5rem]">
        {
          entry.data.summary && (
            <div class="shrink-0">
              <p class="label-tech">Summary</p>
              <p class="mt-2 text-sm leading-relaxed text-lp-muted line-clamp-3">{entry.data.summary}</p>
            </div>
          )
        }
        {
          toc.length > 0 && (
            <nav data-pager-toc aria-label="目次" class="flex min-h-0 flex-1 flex-col">
              <p class="label-tech">Contents</p>
              <ul class="mt-3 min-h-0 flex-1 space-y-2 overflow-y-auto border-l border-lp-border pb-6 [mask-image:linear-gradient(to_bottom,#000_calc(100%-2.5rem),transparent)] [scrollbar-width:none]">
                {toc.map((h) => (
                  <li
                    class={`relative before:absolute before:-left-px before:inset-y-0 before:w-[2px] before:origin-top before:scale-y-0 before:bg-lp-highlight before:transition-transform has-[[aria-current=location]]:before:scale-y-100 ${h.depth === 3 ? 'pl-7 text-xs' : 'pl-4 text-sm'}`}
                  >
                    <a
                      href={`#${h.slug}`}
                      class="block leading-snug text-lp-muted transition-colors hover:text-lp-text aria-[current=location]:text-lp-text"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </Fragment>

    <Content />

    <footer class="not-prose mt-12 break-inside-avoid border-t border-lp-border-subtle pt-6">
      <p class="label-tech">Tags</p>
      <div class="mt-3">
        <Tags tags={entry.data.tags} link={(tag) => `/blog/tags/${tag}`} />
      </div>
      <PostNav
        prev={prevPost ? { href: `/blog/${prevPost.id}`, title: prevPost.data.title } : null}
        next={nextPost ? { href: `/blog/${nextPost.id}`, title: nextPost.data.title } : null}
        prevLabel="← Newer"
        nextLabel="Older →"
        backHref="/blog"
        backLabel="記事の一覧へ"
      />
    </footer>
  </ReaderScreen>
</Layout>
