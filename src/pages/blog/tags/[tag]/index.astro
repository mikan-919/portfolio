---
import { getCollection } from 'astro:content'
import Archive from '@/components/archive/Archive.astro'
import Layout from '@/layouts/Layout.astro'
import { sortByDateDescending } from '@/lib/collectionUtils'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  const allTags = articles.flatMap((a) => a.data.tags)
  const uniqueTags = [...new Set(allTags)]
  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { tag, articles: sortByDateDescending(articles.filter((a) => a.data.tags.includes(tag))) },
  }))
}

const { tag, articles } = Astro.props
---

<Layout title={`#${tag}`} description={`#${tag} の記事一覧`}>
  <Archive kind="article" entries={articles} tag={tag} />
</Layout>
