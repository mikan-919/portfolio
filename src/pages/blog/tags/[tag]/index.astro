---
import { getCollection } from 'astro:content'
import ArchiveList from '@/components/archive/ArchiveList.astro'
import Layout from '@/layouts/Layout.astro'
import { articleToCard } from '@/types/cards'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  const allTags = articles.flatMap((a) => a.data.tags)
  const uniqueTags = [...new Set(allTags)]
  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { tag, articles: articles.filter((a) => a.data.tags.includes(tag)) },
  }))
}

const { tag, articles } = Astro.props
---

<Layout title={`#${tag}`} description={`#${tag} の記事一覧`}>
  <div class="px-5 sm:px-8 md:px-16 lg:px-[7.5rem] pt-12 pb-4">
    <a href="/blog" class="font-mono text-xs text-lp-muted hover:text-lp-text transition-colors">← Blog に戻る</a>
    <h1 class="font-display text-4xl tracking-tight text-lp-text mt-4">#{tag}</h1>
  </div>
  <ArchiveList items={articles.map(articleToCard)} emptyLabel="No articles found." />
</Layout>
