---
import { getCollection } from 'astro:content'
import Archive from '@/components/archive/Archive.astro'
import Layout from '@/layouts/Layout.astro'
import { sortByDateDescending } from '@/lib/collectionUtils'

const allArticles = await getCollection('articles')
const sortedArticles = sortByDateDescending(allArticles)
---

<Layout title="Blog" description="摘果みかんのブログ。日常とプログラミングについて書いています。">
  <Archive kind="article" entries={sortedArticles} />
</Layout>
